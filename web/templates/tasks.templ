package templates

import (
	"encoding/json"
	"fmt"
	"net/url"
	"sort"
	"strconv"
	"time"

	"github.com/novshi-tech/boid/internal/apiwire"
	"github.com/novshi-tech/boid/internal/orchestrator"
	"github.com/novshi-tech/boid/internal/timeline"
	"github.com/novshi-tech/boid/web/templates/components"
	"gopkg.in/yaml.v3"
)

templ TaskIdentityLinks(identities []apiwire.TaskIdentity) {
	if len(identities) > 0 {
		<div class="task-identities" aria-label="Linked identities">
			<strong>Linked resources</strong>
			for _, identity := range identities {
				<div class="task-identity-link">
					<span class="task-identity-key">{ identity.Identity }</span>
					if identity.URL != "" {
						<a href={ identity.URL } target="_blank" rel="noopener noreferrer">{ identityLinkLabel(identity) }</a>
					} else {
						<span class="task-identity-unset">reference unavailable</span>
					}
				</div>
			}
		</div>
	}
}

func identityLinkLabel(identity apiwire.TaskIdentity) string {
	if identity.DisplayName != "" {
		return identity.DisplayName
	}
	return identity.Identity
}

// instructionDisplay carries a single instruction history entry annotated
// with the display label shown in the task detail view. The active
// (most-recent) entry is rendered as "active"; older entries get their
// numeric position to preserve audit context.
type instructionDisplay struct {
	Label       string
	Instruction orchestrator.Instruction
}

// orderedInstructions returns the task's instruction history in display
// order. The active entry comes first so the reader sees the live
// instruction before any superseded history.
func orderedInstructions(inst orchestrator.Instructions) []instructionDisplay {
	if len(inst) == 0 {
		return nil
	}
	out := make([]instructionDisplay, 0, len(inst))
	out = append(out, instructionDisplay{Label: "active", Instruction: inst[len(inst)-1]})
	for i := len(inst) - 2; i >= 0; i-- {
		out = append(out, instructionDisplay{Label: fmt.Sprintf("history #%d", i+1), Instruction: inst[i]})
	}
	return out
}

// payloadAsYAML renders a JSON-encoded payload as YAML for the Payload
// tab. JSON is hard to scan in the browser (braces, quoted keys); YAML
// keeps the same data shape but makes structure visible. Falls back to
// the original JSON bytes when parsing or marshalling fails.
func payloadAsYAML(raw []byte) string {
	if len(raw) == 0 {
		return ""
	}
	if s := string(raw); s == "null" {
		return ""
	}
	var v any
	if err := json.Unmarshal(raw, &v); err != nil {
		return string(raw)
	}
	out, err := yaml.Marshal(v)
	if err != nil {
		return string(raw)
	}
	return string(out)
}

// instrActiveField returns the named field of inst, or "" when inst is nil.
func instrActiveField(inst *orchestrator.Instruction, field string) string {
	if inst == nil {
		return ""
	}
	switch field {
	case "message":
		return inst.Message
	case "model":
		return inst.Model
	case "agent":
		return inst.Agent
	}
	return ""
}

// taskFilterActive reports whether the user has narrowed the list with any
// filter beyond the default (全状態表示) view. Used to switch the empty-state
// copy between "no tasks at all" and "filters match nothing".
//
// docs/plans/webui-detail-list-redesign.md PR-4 (§3.5): the old Open/Closed/
// Queue/Parked status tabs are gone, so f.Status is no longer a "view
// selector" with its own empty-state branch (taskStatusIsDefaultView, this
// function's old neighbor, is deleted along with them) — an explicit status
// now behaves exactly like any other narrowing filter, and ActiveOnly joins
// the same list.
func taskFilterActive(f orchestrator.TaskFilter) bool {
	return f.Title != "" || f.ProjectID != "" || f.Behavior != "" || f.WorkspaceID != "" || f.Status != "" || f.ActiveOnly
}

// pageURL returns currentURL with its "page" query parameter set to page
// (or removed entirely when page <= 1, keeping the canonical/bookmarkable
// URL for page 1 free of a redundant "page=1"). Used by the pagination nav
// (§3.5, §5 論点4: LIMIT/OFFSET) to build Prev/Next links without
// hand-splicing query strings.
func pageURL(currentURL string, page int) string {
	u, err := url.Parse(currentURL)
	if err != nil {
		return currentURL
	}
	q := u.Query()
	if page <= 1 {
		q.Del("page")
	} else {
		q.Set("page", strconv.Itoa(page))
	}
	u.RawQuery = q.Encode()
	return u.String()
}

// TaskListFragment renders only the task list container (for HTMX partial responses).
// currentURL is embedded as the polling target so filter params are preserved across polls.
// page/hasMore drive the pagination nav (§3.5): page is the current 1-indexed
// page, hasMore reports whether WebHandler.TaskList found more rows past
// this page's LIMIT (it fetches pageSize+1 to answer this without a second
// COUNT query — see web.go's own doc comment).
templ TaskListFragment(items []ListRow, filter orchestrator.TaskFilter, page int, hasMore bool, currentURL string) {
	<div
		id="task-list"
		hx-get={ currentURL }
		hx-trigger="every 5s"
		hx-target="#task-list"
		hx-swap="outerHTML"
	>
		if len(items) == 0 && page <= 1 {
			if taskFilterActive(filter) {
				<div class="empty-state">
					<div class="empty-state-title">No tasks match the current filters</div>
					<p class="empty-state-hint">Try adjusting your search terms or filters.</p>
					<a href="/?cleared=1" class="btn btn-secondary empty-state-cta">Clear filters</a>
				</div>
			} else {
				<div class="empty-state">
					<div class="empty-state-title">No tasks yet</div>
					<p class="empty-state-hint">Create your first task to get started.</p>
					<a href="/tasks/new" class="btn btn-primary empty-state-cta">+ Create</a>
				</div>
			}
		} else {
			if len(items) == 0 {
				<div class="empty-state">
					<div class="empty-state-title">Nothing on this page</div>
					<p class="empty-state-hint">Go back to an earlier page.</p>
				</div>
			} else {
				@taskListRows(items)
			}
			if page > 1 || hasMore {
				@taskListPagination(currentURL, page, hasMore)
			}
		}
	</div>
}

// taskListPagination renders the Prev/Next nav (§3.5, §5 論点4). Both links
// navigate like every other filter control on this page (hx-target=
// #main-content, hx-push-url) so the page number round-trips through the
// URL and survives a bookmark/reload, not just an in-session click.
templ taskListPagination(currentURL string, page int, hasMore bool) {
	<nav class="list-pagination" aria-label="ページ">
		if page > 1 {
			<a
				href={ templ.SafeURL(pageURL(currentURL, page-1)) }
				class="btn btn-secondary btn-sm"
				hx-get={ pageURL(currentURL, page-1) }
				hx-target="#main-content"
				hx-swap="innerHTML"
				hx-select="#main-content"
				hx-push-url="true"
			>← Prev</a>
		}
		<span class="list-pagination-page">{ fmt.Sprintf("%d", page) }</span>
		if hasMore {
			<a
				href={ templ.SafeURL(pageURL(currentURL, page+1)) }
				class="btn btn-secondary btn-sm"
				hx-get={ pageURL(currentURL, page+1) }
				hx-target="#main-content"
				hx-swap="innerHTML"
				hx-select="#main-content"
				hx-push-url="true"
			>Next →</a>
		}
	</nav>
}

func taskStatusClass(s string) string {
	return "badge badge-" + s
}

// hasAction reports whether name is present in availableActions — the
// StateMachine.AvailableActions(task.Status) result GetTaskDetail computes
// (internal/api/web_service.go). Used to gate kebab-menu items (abort/park/
// drop) generically instead of a hand-maintained status-exclusion list,
// which PR-1's Phase 1 実測結果 項11 flagged as the intended UI wiring point
// for new manual actions.
func hasAction(availableActions []string, name string) bool {
	for _, a := range availableActions {
		if a == name {
			return true
		}
	}
	return false
}

func shortID(id string) string {
	if len(id) <= 8 {
		return id
	}
	return id[:8]
}

type filterOption struct {
	Value string
	Label string
}

// TaskListContent renders the inner content (filter form + task list) for HTMX partial swaps.
templ TaskListContent(items []ListRow, filter orchestrator.TaskFilter, page int, hasMore bool, projects []*orchestrator.Project, workspaces []*orchestrator.WorkspaceSummary, currentURL string) {
	<div id="main-content">
		@components.TaskFilters(filter, projects, workspaces)
		@TaskListFragment(items, filter, page, hasMore, currentURL)
	</div>
}

templ TaskList(items []ListRow, filter orchestrator.TaskFilter, page int, hasMore bool, projects []*orchestrator.Project, workspaces []*orchestrator.WorkspaceSummary, currentURL string) {
	@Layout("Tasks", "") {
		@TaskListContent(items, filter, page, hasMore, projects, workspaces, currentURL)
		@TaskListActionBar()
	}
}

// TaskListActionBar renders the sticky bottom bar for the task list page.
// The only action is "Create" — positioned on the left to mirror the
// detail page's primary-action layout so the mental model of "bottom-left
// = primary forward action" stays consistent across pages.
templ TaskListActionBar() {
	<div class="action-bar">
		<div class="action-bar-inner">
			<a href="/tasks/new" class="btn btn-primary action-bar-primary-form">Create</a>
			<span class="action-bar-spacer"></span>
		</div>
	</div>
}

// detailProjectLabel returns the resolved project name when available,
// falling back to the project ID.
func detailProjectLabel(task *orchestrator.Task, projectName string) string {
	if projectName != "" {
		return projectName
	}
	return task.ProjectID
}

// cardIdentityLabel renders the "素性の段" (identity row) text for a card
// detail page: "<project> / <kind>" (docs/plans/webui-detail-list-redesign.md
// §3.1, part A of the meta 2-段 regulation). The old shared status strip
// used to fill the behavior slot with the literal string "card" for a card
// (its own doc comment called this a filler, "空欄にしないため") — §3.1
// retires that filler outright: a card genuinely has no behavior, and the
// entity split means this label is never rendered for anything but a card,
// so there is no shared slot left to keep non-blank.
func cardIdentityLabel(task *orchestrator.Task, projectName string) string {
	kind := ""
	if task.Card != nil {
		kind = task.Card.Kind
	}
	if task.ProjectID == "" {
		return kind
	}
	return detailProjectLabel(task, projectName) + " / " + kind
}

// execIdentityLabel is cardIdentityLabel's execution-task counterpart:
// "<project> / <behavior>".
func execIdentityLabel(task *orchestrator.Task, projectName string) string {
	behavior := ""
	if task.Exec != nil {
		behavior = task.Exec.Behavior
	}
	if task.ProjectID == "" {
		return behavior
	}
	return detailProjectLabel(task, projectName) + " / " + behavior
}

// suggestionTargetStatus returns the status a suggestion's verb would move a
// card to, so the movement row can render the transition as an edge
// ("parked —go→ working", §3.1 部品A). Reads the answer directly off card
// machine v2's own rule table (machine_card.go) instead of a second,
// hand-maintained verb→status map, so this can never silently drift from
// the machine that actually governs the transition. Returns "" when no
// manual, status-changing rule matches — defensive against a future verb
// the card machine doesn't (yet) recognize; the caller falls back to
// showing the bare status badge with no arrow in that case.
func suggestionTargetStatus(status orchestrator.TaskStatus, verb string) string {
	for _, r := range orchestrator.NewCardMachine().Rules {
		if r.Manual && r.Action == verb && r.ToStatus != "" && (r.FromStatus == "*" || r.FromStatus == string(status)) {
			return r.ToStatus
		}
	}
	return ""
}

// taskExecPayload/taskExecInstructions read Payload/Instructions off a
// task's Exec attrs, returning the zero value for a card (card-model-cleanup
// PR-2: both are execution-only fields — design doc §3.2). Both fields are
// execution-only vocabulary in the first place (§3.3's "出さないもの": Payload
// / Instructions never render on the card layout at all post-entity-split),
// but these two helpers stay nil-safe regardless, since taskExecPayload also
// backs TaskDetailAwaitingBanner, which any task (including, in principle, a
// future card status this PR doesn't add) could reach.
func taskExecPayload(task *orchestrator.Task) json.RawMessage {
	if task.Exec == nil {
		return nil
	}
	return task.Exec.Payload
}

func taskExecInstructions(task *orchestrator.Task) orchestrator.Instructions {
	if task.Exec == nil {
		return nil
	}
	return task.Exec.Instructions
}

// projectOptionLabel returns the display label for a project in a select dropdown.
func projectOptionLabel(p *orchestrator.Project) string {
	if p.Meta.Name != "" {
		return p.Meta.Name
	}
	return p.ID
}

// detailRowClasses returns the class list for the unified status card,
// reusing the list-row palette (status stripe + blocked dim).
func detailRowClasses(task *orchestrator.Task) []string {
	classes := []string{"detail-card", "task-row-status-" + string(task.Status)}
	if task.Blocked {
		classes = append(classes, "task-row-blocked")
	}
	return classes
}

// TaskDetailCardStatusSection renders the card detail page's frameless meta
// strip: the identity row, a bare status badge, and the current summary.
// Lives inside #task-status, so it stays live-refreshed by the existing SSE
// script on the card's own actions (a suggestion write, a command's own
// terminal record, ...).
//
// Current timeline items live in #task-pinned. The instruction form stays
// outside both refreshed sections so live updates preserve an unfinished draft.
//
// id="task-status" carries data-task-id so TaskDetailLiveScript (shared by
// both the card and execution layouts, §7 罠2) can find the task id without
// depending on #tab-panel, which the card layout does not have.
templ TaskDetailCardStatusSection(task *orchestrator.Task, errorMsg string, projectName string, summary string, identities []apiwire.TaskIdentity) {
	<div id="task-status" data-task-id={ task.ID }>
		<div class={ detailRowClasses(task) }>
			<div class="detail-identity">{ cardIdentityLabel(task, projectName) }</div>
			<div class="detail-meta">
				<span class={ taskStatusClass(string(task.Status)) }>{ string(task.Status) }</span>
				<span class="detail-meta-sep">·</span>
				<span class="detail-time">{ task.UpdatedAt.Local().Format("2006-01-02 15:04") }</span>
			</div>
		</div>
		if errorMsg != "" {
			<div class="action-error">{ errorMsg }</div>
		}
		@TaskDetailCardSummary(summary, task.Description)
		@TaskIdentityLinks(identities)
	</div>
}

// TaskDetailCardPinnedSection wraps CardPinnedSection in its own
// SSE-refreshed container (#task-pinned, fragment kind=pinned), split out of
// #task-status — see that function's own doc comment for why.
templ TaskDetailCardPinnedSection(tl *CardTimelineView, cardID string, cardStatus orchestrator.TaskStatus) {
	<div id="task-pinned" data-task-id={ cardID }>
		if tl != nil {
			@cardActivityBadges(CardActivityState{WorkLabel: tl.Activity.WorkLabel, DecisionLabel: tl.Activity.DecisionLabel})
		}
		@CardPinnedSection(tl, cardID, cardStatus)
	</div>
}

// TaskDetailExecStatusSection is TaskDetailCardStatusSection's execution-task
// counterpart: identity row is "<project> / <behavior>"; the movement row
// shows status + elapsed while executing, or the existing awaiting banner.
templ TaskDetailExecStatusSection(task *orchestrator.Task, errorMsg string, projectName string, childTree []ChildTreeNode, identities []apiwire.TaskIdentity) {
	<div id="task-status" data-task-id={ task.ID }>
		<div class={ detailRowClasses(task) }>
			<div class="detail-identity">{ execIdentityLabel(task, projectName) }</div>
			<div class="detail-meta">
				<span class={ taskStatusClass(string(task.Status)) }>{ string(task.Status) }</span>
				if task.Status == orchestrator.TaskStatusExecuting {
					<span class="detail-meta-sep">·</span>
					<span>{ timeline.FormatElapsed(task.UpdatedAt) } 経過</span>
				}
				<span class="detail-meta-sep">·</span>
				<span class="detail-time">{ task.UpdatedAt.Local().Format("2006-01-02 15:04") }</span>
			</div>
		</div>
		@TaskIdentityLinks(identities)
		if errorMsg != "" {
			<div class="action-error">{ errorMsg }</div>
		}
		if task.Status == orchestrator.TaskStatusAwaiting {
			@TaskDetailAwaitingBanner(task)
		}
	</div>
}

// TaskDetailSuggestionSection renders task_triage.detail.suggestion (or
// detail.attrs.suggestion — orchestrator.DetailSuggestion) as a compact
// card right under the status row: verb + action, then reason and basis on
// their own lines. This is the only place Basis is shown (the list row's
// 3行目, task_list_row.templ, only has room for verb + reason). Renders
// nothing when there is no suggestion — every non-triage task, and any
// triage task khi hasn't evaluated yet.
//
// docs/plans/ingestion-identity.md PR-3 (B-3+B-4, J-6): Accept/Reject
// buttons close "既に開いている穴" — 決定14 moved judgment to the Web UI, but
// until this PR the Web UI had no path to RECORD a reject, so khi's
// re-suggestion suppression (rejection_index) never actually fired for a
// Web UI click. Each button POSTs an `answered` action
// (WebHandler.PostAnswerSuggestion) carrying the CURRENTLY-shown
// suggestion's own verb/basis as hidden fields — the daemon records them
// but never validates or cross-checks them (J-7). taskID is a plain string
// (not *orchestrator.Task) so this function's existing unit tests
// (tasks_test.go) don't need a full Task fixture just to exercise the
// suggestion-only rendering.
//
// status gates the Accept/Reject buttons specifically (Opus review finding
// #3, 2026-08-19 revisit): `answered` is only a valid transition from
// preExecutionStatuses (captured/triaged/parked/ready/working,
// machine_card.go). A triage task that carries a stale, never-answered
// suggestion into done/dropped/aborted (auto-done, or nobody clicked before
// it advanced) used to still render live-looking buttons that redirected to
// an opaque `no transition for action "answered" from status "done"` error
// on click. orchestrator.NewCardMachine().CanApplyManualAction is the single
// source of truth for "would answered actually be accepted from this
// status" — the suggestion's own text still renders either way; only the
// buttons hide. NewCardMachine (not machineFor's dynamic task-based
// selection, PR-B) is correct here specifically because this section only
// ever renders when suggestion.Verb != "" — a suggestion only ever exists on
// a task_triage sidecar row (a card) in the first place, so which machine
// applies is never actually ambiguous at this call site.
//
// PR-3 (suggestion 状態遷移化 follow-up) adds a SECOND, narrower gate inside
// the block CanApplyManualAction("answered", status) admits: card machine v2
// pins exactly one status per VERB (e.g. "complete" only fires from "working",
// machine_card.go's own doc comment), but CanApplyManualAction("answered",
// status) alone says yes for ALL FOUR card statuses regardless of the
// suggestion's own verb — it only asks "can the answered ACTION apply here",
// never "would THIS VERB actually transition from here". Before this PR, a
// suggestion whose verb didn't match the card's current status (e.g. a
// stale "complete" suggestion sitting on a card a direct park click
// already moved back to parked) still rendered a live-looking Accept
// button that 409'd on click with `no transition for action "complete"
// from status "parked"`. components.SuggestionInapplicable (orchestrator.StateMachine.
// CanApplyTransitionAction) is the single source of truth for "would this
// SPECIFIC verb actually apply from this SPECIFIC status" — when it says no,
// Accept is replaced by a plain-language explanation
// (components.SuggestionInapplicableReason) but Reject still renders: an
// inapplicable suggestion must remain dismissible, or it lingers in the
// queue forever with no way to clear it (this PR's own description covers
// why the queue predicate itself is NOT changed to hide it instead).
templ TaskDetailSuggestionSection(taskID string, status orchestrator.TaskStatus, suggestion orchestrator.Suggestion) {
	if suggestion.Verb != "" {
		<div class="detail-suggestion">
			<div class="detail-suggestion-header">
				<span class={ "badge", components.VerbBadgeClass(suggestion.Verb) }>{ suggestion.Verb }</span>
				if suggestion.Action != "" {
					<span class="detail-suggestion-action">{ suggestion.Action }</span>
				}
			</div>
			if suggestion.Reason != "" {
				<div class="detail-suggestion-reason">{ suggestion.Reason }</div>
			}
			if suggestion.Basis != "" {
				<div class="detail-suggestion-basis">basis: { suggestion.Basis }</div>
			}
			if orchestrator.NewCardMachine().CanApplyManualAction("answered", status) {
				<div class="detail-suggestion-answer">
					// PR #988 review, MEDIUM 1: accept is a SECOND entry point to the
					// exact same transition TaskActionBar's kebab menu reaches directly
					// (park/drop, below) — it must carry the identical warning, not a
					// lighter one just because it arrived via a suggestion instead of a
					// direct click. templ requires "on*" attributes to be static script
					// literals (isScriptAttribute, a-h/templ generator), so the
					// verb-specific onsubmit text is branched here rather than built from
					// a Go string expression — three near-duplicate <form> bodies, same
					// idiom TaskActionBar itself already uses for its own per-action
					// onsubmit variants just above.
					//
					// PR-3: the whole three-way Accept branch is now gated on
					// components.SuggestionInapplicable — see this templ's own doc
					// comment above for why. Reject (below) is NOT inside this gate:
					// it must always render here, or an inapplicable suggestion could
					// never be cleared from the queue.
					if components.SuggestionInapplicable(suggestion.Verb, status) {
						<div class="detail-suggestion-inapplicable">{ components.SuggestionInapplicableReason(suggestion.Verb, status) }</div>
					} else if suggestion.Verb == "drop" {
						// Mirrors the kebab menu's direct "drop" item: SAME confirm text
						// (tx.UnlinkAllForTask releases every identity bound to this card —
						// this is exactly as irreversible via accept as via a direct click)
						// and a danger-colored button, not the plain primary every other
						// verb's accept keeps.
						<form method="post" action={ templ.SafeURL("/tasks/" + taskID + "/suggestion") } class="detail-suggestion-answer-form" onsubmit="return confirm('Drop this task? This discards it — a dropped task does not resume.')">
							<input type="hidden" name="answer" value="accept"/>
							<input type="hidden" name="verb" value={ suggestion.Verb }/>
							<input type="hidden" name="basis" value={ suggestion.Basis }/>
							<button type="submit" class={ acceptButtonClass(suggestion.Verb) }>{ acceptButtonLabel(suggestion.Verb) }</button>
						</form>
					} else if suggestion.Verb == "park" {
						// Mirrors the kebab menu's direct "park" item: same confirm text.
						// Not danger-colored (park is reversible — wake/reopen brings the
						// card back), just the same "are you sure" prompt.
						<form method="post" action={ templ.SafeURL("/tasks/" + taskID + "/suggestion") } class="detail-suggestion-answer-form" onsubmit="return confirm('Park this task (set aside for later)?')">
							<input type="hidden" name="answer" value="accept"/>
							<input type="hidden" name="verb" value={ suggestion.Verb }/>
							<input type="hidden" name="basis" value={ suggestion.Basis }/>
							<button type="submit" class={ acceptButtonClass(suggestion.Verb) }>{ acceptButtonLabel(suggestion.Verb) }</button>
						</form>
					} else {
						<form method="post" action={ templ.SafeURL("/tasks/" + taskID + "/suggestion") } class="detail-suggestion-answer-form">
							<input type="hidden" name="answer" value="accept"/>
							<input type="hidden" name="verb" value={ suggestion.Verb }/>
							<input type="hidden" name="basis" value={ suggestion.Basis }/>
							<button type="submit" class={ acceptButtonClass(suggestion.Verb) }>{ acceptButtonLabel(suggestion.Verb) }</button>
						</form>
					}
					<form method="post" action={ templ.SafeURL("/tasks/" + taskID + "/suggestion") } class="detail-suggestion-answer-form">
						<input type="hidden" name="answer" value="reject"/>
						<input type="hidden" name="verb" value={ suggestion.Verb }/>
						<input type="hidden" name="basis" value={ suggestion.Basis }/>
						<button type="submit" class="btn btn-secondary btn-sm">Reject</button>
					</form>
				</div>
			}
		</div>
	}
}

// ChildTreeNode is one direct child on an execution detail page.
type ChildTreeNode struct {
	Task           *orchestrator.Task
	QuestionID     string
	CreatedAt      time.Time
	HasCreatedAt   bool
	TerminalEvents []ChildTerminalEvent
}

// ChildTerminalEvent snapshots one actual terminal transition. Keeping the
// transition status here prevents a later reopen from rewriting history.
type ChildTerminalEvent struct {
	Status  orchestrator.TaskStatus
	Time    time.Time
	HasTime bool
}

type execChildHistoryEvent struct {
	Task    *orchestrator.Task
	Kind    string
	Time    time.Time
	HasTime bool
	Status  orchestrator.TaskStatus
}

func execChildHistoryEvents(nodes []ChildTreeNode) []execChildHistoryEvent {
	events := make([]execChildHistoryEvent, 0, len(nodes)*2)
	for _, node := range nodes {
		events = append(events, execChildHistoryEvent{Task: node.Task, Kind: "Created", Time: node.CreatedAt, HasTime: node.HasCreatedAt})
		for _, terminal := range node.TerminalEvents {
			events = append(events, execChildHistoryEvent{Task: node.Task, Kind: "Finished", Time: terminal.Time, HasTime: terminal.HasTime, Status: terminal.Status})
		}
	}
	sort.SliceStable(events, func(i, j int) bool {
		if events[i].HasTime != events[j].HasTime {
			return events[i].HasTime
		}
		return events[i].Time.After(events[j].Time)
	})
	return events
}

// TaskDetailExecChildTreeSection renders direct children. Opening a child
// repeats the same one-level view for the next depth.
templ TaskDetailExecChildTreeSection(nodes []ChildTreeNode) {
	if len(nodes) > 0 {
		<div class="detail-child-tree">
			<div class="detail-children-label">Current subtasks ({ fmt.Sprintf("%d", len(nodes)) })</div>
			<ul class="detail-child-tree-list">
				for _, node := range nodes {
					<li class="detail-child-tree-item">
						<div class="detail-children-item">
							<a href={ templ.SafeURL("/tasks/" + node.Task.ID) } class="detail-children-title">{ node.Task.Title }</a>
							<div class="detail-children-meta">
								<span class={ taskStatusClass(string(node.Task.Status)) }>{ string(node.Task.Status) }</span>
								if node.Task.Exec != nil && node.Task.Exec.Behavior != "" {
									<span class="badge badge-child-behavior">{ node.Task.Exec.Behavior }</span>
								}
								if node.QuestionID != "" {
									<a href={ templ.SafeURL("/tasks/" + node.Task.ID + "/questions/" + node.QuestionID) } class="detail-children-ask"><span aria-hidden="true">⚠</span> question</a>
								}
								if orchestrator.IsTerminalStatus(node.Task.Status) && len(node.TerminalEvents) == 0 {
									<span class="detail-children-hint">completion time unavailable</span>
								}
							</div>
						</div>
					</li>
				}
			</ul>
			<div class="detail-children-label exec-child-history-label">Subtask history</div>
			<ul class="card-timeline-list exec-child-history">
				for _, event := range execChildHistoryEvents(nodes) {
					<li class="card-timeline-item">
						<time class="card-timeline-item-time">
							if event.HasTime {
								{ event.Time.Local().Format("Jan 2 15:04") }
							} else {
								unknown time
							}
						</time>
						<div class="card-timeline-item-body card-timeline-child-finished">
							<a href={ templ.SafeURL("/tasks/" + event.Task.ID) } class="detail-children-link">{ event.Kind }: { event.Task.Title }</a>
							if event.Kind == "Finished" {
								<span class={ taskStatusClass(string(event.Status)) }>{ string(event.Status) }</span>
							}
						</div>
					</li>
				}
			</ul>
		</div>
	}
}

// detailPrimaryAction picks the single state-aware "primary" action for the
// bottom bar. Mirrors TUI semantics:
//   - pending   → start  (forward, primary)
//   - executing → abort  (the only safe manual move; done is intentionally hidden)
//   - done      → reopen+rerun (both primary; see TaskActionBar) — for an
//     ordinary task; a done CARD is handled by TaskActionBar's own
//     hasTriage branch before this function is ever called
//   - aborted   → reopen+rerun (both primary; see TaskActionBar)
//   - parked    → go (card machine v2, docs/plans/
//     suggestion-as-state-transition.md §3.2: parked's forward edge —
//     dispatches any specced children, then working)
//   - working   → complete (card machine v2: the natural forward edge once
//     work is underway; park is the lighter "not yet, set aside" move and
//     stays in the kebab menu instead of competing for the primary slot.
//     Go is ALSO applicable from working — a working→working self-loop —
//     but stays in the kebab menu instead of displacing Complete as
//     primary, since AvailableActions deliberately excludes self-loops;
//     see the kebab menu's own "go" item, TaskCardActionBar)
//
// dropped is deliberately absent from this switch — TaskActionBar's own
// hasTriage branch (mirroring done above) renders a Reopen link for it
// directly, the same way done/aborted already get theirs, without ever
// reaching detailPrimaryAction.
//
// Returns ("", "") when no primary action applies.
func detailPrimaryAction(task *orchestrator.Task, availableActions []string) (action, label string) {
	switch task.Status {
	case orchestrator.TaskStatusPending:
		for _, a := range availableActions {
			if a == "start" {
				return "start", "Start"
			}
		}
	case orchestrator.TaskStatusExecuting:
		for _, a := range availableActions {
			if a == "abort" {
				return "abort", "Abort"
			}
		}
	case orchestrator.TaskStatusAborted:
		return "rerun", "Rerun"
	case orchestrator.TaskStatusParked:
		for _, a := range availableActions {
			if a == "go" {
				return "go", "Go"
			}
		}
	case orchestrator.TaskStatusWorking:
		for _, a := range availableActions {
			if a == "complete" {
				return "complete", "Complete"
			}
		}
	}
	return "", ""
}

// actionPrimaryClass picks the visual variant for the primary bottom-bar
// button: blue for forward (start/go/complete), red for destructive
// (abort), neutral for re-execute (rerun).
func actionPrimaryClass(action string) string {
	switch action {
	case "start", "go", "complete":
		return "btn btn-primary"
	case "abort":
		return "btn btn-danger"
	default:
		return "btn btn-secondary"
	}
}

// acceptButtonClass picks the suggestion Accept button's visual weight per
// verb (PR-2, docs/plans/suggestion-as-state-transition-impl.md §4.3, design
// doc §3.2; drop/park weighting added per PR #988 review, MEDIUM 1):
//
//   - "go" dispatches specced children and starts real work — the same
//     consequence as the bottom action bar's own primary Go button
//     (actionPrimaryClass("go") above) — so it gets that same full-weight
//     "btn btn-primary" class, not the compact variant every other verb uses.
//   - "drop" releases every identity bound to the card
//     (tx.UnlinkAllForTask, workflow_action.go) — exactly as irreversible as
//     the kebab menu's direct "drop" item, which is danger-colored
//     (action-menu-item-danger). Accept("drop") gets the matching
//     "btn btn-danger" treatment instead of the plain primary every other
//     verb keeps — MEDIUM 1 flagged that the MOST destructive verb was
//     previously rendered with the LIGHTEST styling of all six.
//   - working/park/done/reopen never task-ify or release identities on
//     accept, so they keep the original compact "btn btn-primary btn-sm".
//     park additionally gets a confirm() dialog (see the caller,
//     TaskDetailSuggestionSection) matching its own kebab item, but does not
//     need danger coloring — park is reversible (reopen/wake bring the card
//     back).
func acceptButtonClass(verb string) string {
	switch verb {
	case "go":
		return "btn btn-primary"
	case "drop":
		return "btn btn-danger btn-sm"
	default:
		return "btn btn-primary btn-sm"
	}
}

// acceptButtonLabel makes the Accept button itself read "what am I
// accepting" (PR #988 review, MEDIUM 1 — implementation plan §4.3's "accept
// が『何を承認するのか』が読める形" requirement): the verb badge already shows
// this, but the review flagged that the BUTTON text said only "Accept"
// regardless of verb, leaving the actual consequence readable only from a
// separate badge a click could miss.
func acceptButtonLabel(verb string) string {
	return "Accept: " + verb
}

// TaskCardActionBar renders the sticky bottom action bar for a card detail
// page. Card detail has no tabs (§7 罠1), so — unlike TaskExecActionBar —
// this always renders; there is no activeTab gate.
//
// This is the "escape hatch" design doc §3.2 requires: every card-machine
// transition must stay reachable by a direct human click, independent of
// whatever suggestion (if any) TaskDetailCardStatusSection's movement row is
// showing (§3.3 item 5's role split — the suggestion's own Accept/Reject
// lives there, not here).
//
// Split out of the old shared TaskActionBar (which used to carry BOTH card
// and execution branches behind a hasTriage bool — see git history). The
// branches kept here are copied verbatim (same POST targets, same hidden
// fields, same confirm() text) from that function's hasTriage==true paths,
// so PR-1's "遷移機能等価" holds. The branches NOT carried over (the
// hasTriage==false Reopen+Rerun variant, the plain non-menu-item
// exec path) never applied to a card in the first place — card machine v2
// (machine_card.go) has no "abort" rule at all, and "pending"/"executing"/
// "awaiting"/"aborted" are execution-only statuses a card can never reach,
// so the removed code paths were unreachable dead branches for a card
// caller both before and after this split.
templ TaskCardActionBar(task *orchestrator.Task, availableActions []string, tl *CardTimelineView) {
	<div id="task-controls" class="action-bar">
		<div class="action-bar-inner">
			if task.Status == orchestrator.TaskStatusDone || task.Status == orchestrator.TaskStatusDropped {
				// card machine v2 (docs/plans/suggestion-as-state-transition.md
				// §3.2): a done/dropped card reopens to parked, never
				// executing — no Rerun here, "re-executing a card as a job"
				// is not a real concept (a card never runs its own session).
				<a href={ templ.SafeURL("/tasks/" + task.ID + "/reopen") } class="btn btn-primary action-bar-primary-form">Reopen</a>
			} else {
				{{ action, label := detailPrimaryAction(task, availableActions) }}
				if action == "go" {
					@CardGoControl(tl, task.ID)
				} else if action != "" {
					<form method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/action") } class="action-bar-primary-form">
						<input type="hidden" name="type" value={ action }/>
						<button type="submit" class={ actionPrimaryClass(action) }>{ label }</button>
					</form>
				} else {
					<span class="action-bar-spacer"></span>
				}
			}
			if task.Status == orchestrator.TaskStatusWorking {
				@CardGoControl(tl, task.ID)
			}
			<details class="action-menu">
				<summary class="action-menu-summary" aria-label="More actions">⋯</summary>
				<div class="action-menu-list" role="menu">
					<form method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/duplicate") }>
						<button type="submit" class="action-menu-item">duplicate</button>
					</form>
					// start (parked → working, card machine v2: declares
					// manual work without dispatching any specced children —
					// the lighter alternative to Go, which is the bottom
					// bar's primary action instead. Only ever available from
					// parked, so no extra status gate is needed beyond
					// hasAction.
					if hasAction(availableActions, "start") {
						<form method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/action") }>
							<input type="hidden" name="type" value="start"/>
							<button type="submit" class="action-menu-item">start</button>
						</form>
					}
					// park (working → parked, card machine v2, queue から
					// 一時的に外す — 決定9の「後回し」)。
					if hasAction(availableActions, "park") {
						<form method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/action") } onsubmit="return confirm('Park this task (set aside for later)?')">
							<input type="hidden" name="type" value="park"/>
							<button type="submit" class="action-menu-item">park</button>
						</form>
					}
					// complete (parked → done、card 機械 v2 の 8 本目の辺、
					// 2026-08-25。done から改名)。ここで働いた人が
					// 居ないまま閉じる card ——「外で片付いていた」「重複と
					// 判明した」—— のための 1 手。理由は machine_card.go の
					// NewCardMachine doc comment を参照。
					//
					// **status の門が要る。** このメニューは verb を 1 つずつ
					// 列挙していて availableActions を回さないので、working の
					// card では complete が既に bottom bar の primary ボタン
					// (detailPrimaryAction) として出ている。門が無いと同じ
					// 遷移のボタンが 1 画面に 2 つ並ぶ。parked の primary は
					// Go のまま —— card を閉じるのが既定の一手になってはいけない
					// —— なので parked 側はこのメニューが唯一の入口になる。
					if hasAction(availableActions, "complete") && task.Status == orchestrator.TaskStatusParked {
						<form method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/action") } onsubmit="return confirm('Close this card as done? Use this when the work was finished elsewhere, or this card turned out to be a duplicate. It keeps the card&#39;s identities, so the source can still reopen it later.')">
							<input type="hidden" name="type" value="complete"/>
							<button type="submit" class="action-menu-item">complete</button>
						</form>
					}
					// drop (parked → dropped, 必ず nose の判断
					// でのみ入る終端 — 逆輸入2: 「終わった件と捨てた件を区別
					// できないと成功の定義が測れない」)。
					if hasAction(availableActions, "drop") {
						<form method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/action") } onsubmit="return confirm('Drop this task? This discards it — a dropped task does not resume.')">
							<input type="hidden" name="type" value="drop"/>
							<button type="submit" class="action-menu-item action-menu-item-danger">drop</button>
						</form>
					}
					<form method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/delete") } onsubmit="return confirm('Delete this task? This cannot be undone.')">
						<button type="submit" class="action-menu-item action-menu-item-danger">delete</button>
					</form>
				</div>
			</details>
		</div>
	</div>
}

// TaskExecActionBar renders the sticky bottom action bar for an execution
// task detail page: state-aware primary (Start/Abort/Rerun) + "⋯" kebab
// (duplicate / abort / delete). Only shown on the Timeline tab — the other
// tabs (Description/Payload/Instructions) carry no action-bar-relevant
// state.
//
// The card-only branches TaskCardActionBar now owns (the
// Reopen-without-Rerun variant, the working/park/drop/status-gated-done
// menu items) are gone from here: machine_execution.go's rule table never
// grants "working"/"park"/"drop" as an available action for an execution
// task, and "parked" is a status only a card ever reaches, so those
// branches rendered nothing for an execution task before this split either
// — removing them changes no execution task's rendered output (PR-1's
// "遷移機能等価").
templ TaskExecActionBar(task *orchestrator.Task, availableActions []string, activeTab string) {
	if activeTab == "timeline" {
		<div class="action-bar">
			<div class="action-bar-inner">
				if task.Status == orchestrator.TaskStatusAborted || task.Status == orchestrator.TaskStatusDone {
					// reopen re-executes it (execution machine's own reopen:
					// done/aborted→executing).
					<a href={ templ.SafeURL("/tasks/" + task.ID + "/reopen") } class="btn btn-primary action-bar-primary-form">Reopen</a>
					<form method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/rerun") } onsubmit="return confirm('Rerun this task?')">
						<button type="submit" class="btn btn-secondary">Rerun</button>
					</form>
				} else {
					{{ action, label := detailPrimaryAction(task, availableActions) }}
					if action == "rerun" {
						<form method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/rerun") } onsubmit="return confirm('Rerun this task?')" class="action-bar-primary-form">
							<button type="submit" class={ actionPrimaryClass(action) }>{ label }</button>
						</form>
					} else if action == "abort" {
						<form method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/action") } onsubmit="return confirm('Abort this task?')" class="action-bar-primary-form">
							<input type="hidden" name="type" value="abort"/>
							<button type="submit" class={ actionPrimaryClass(action) }>{ label }</button>
						</form>
					} else if action != "" {
						<form method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/action") } class="action-bar-primary-form">
							<input type="hidden" name="type" value={ action }/>
							<button type="submit" class={ actionPrimaryClass(action) }>{ label }</button>
						</form>
					} else {
						<span class="action-bar-spacer"></span>
					}
				}
				if task.Status == orchestrator.TaskStatusPending {
					<a href={ templ.SafeURL("/tasks/" + task.ID + "/edit") } class="btn btn-secondary">Edit</a>
				}
				<details class="action-menu">
					<summary class="action-menu-summary" aria-label="More actions">⋯</summary>
					<div class="action-menu-list" role="menu">
						<form method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/duplicate") }>
							<button type="submit" class="action-menu-item">duplicate</button>
						</form>
						// abort is gated on availableActions rather than the
						// old blanket "not done/aborted/pending" exclusion,
						// since machine.go now scopes it to the
						// execution-lifecycle statuses only. pending is still
						// excluded explicitly — machine.go DOES have a
						// pending→aborted rule, but pending already has its
						// own Edit affordance and hiding abort there predates
						// this PR; not touching that existing product choice.
						if hasAction(availableActions, "abort") && task.Status != orchestrator.TaskStatusPending {
							<form method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/action") } onsubmit="return confirm('Abort this task?')">
								<input type="hidden" name="type" value="abort"/>
								<button type="submit" class="action-menu-item action-menu-item-danger">abort</button>
							</form>
						}
						<form method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/delete") } onsubmit="return confirm('Delete this task? This cannot be undone.')">
							<button type="submit" class="action-menu-item action-menu-item-danger">delete</button>
						</form>
					</div>
				</details>
			</div>
		</div>
	}
}

// timelineEventTime returns the HH:MM:SS event timestamp, or dashes when
// the event predates the tracked timestamp range. Consistent format with
// status-group headers so the right column aligns visually like the TUI.
func timelineEventTime(ev timeline.Event) string {
	if !ev.HasTime {
		return "--:--:--"
	}
	return ev.Time.Local().Format("15:04:05")
}

// timelineGroupTime formats the time the task entered a status. Same HH:MM:SS
// format as events so header and body share one visual time column.
func timelineGroupTime(g timeline.StatusGroup) string {
	if !g.HasEnteredAt {
		return "--:--:--"
	}
	return g.EnteredAt.Local().Format("15:04:05")
}

// timelineJobStatusClass returns the job-status suffix used for marker
// coloring (completed / failed / running / parked / default) so CSS can match
// both kind and status in a single selector.
//
// A "parked" badge is returned when the underlying job is still running but
// the surrounding task is parked on a blocking ask: this happens on the
// synthesized Sticky reference row that the timeline builder appends under
// the awaiting status group. Treat it as a UI synonym for "running, waiting
// on a user answer" — the job's DB row is still `running` (the agent process
// is alive inside `boid task ask`), only the display changes.
func timelineJobStatusClass(ev timeline.Event, taskStatus string) string {
	if ev.Job != nil && ev.Job.Status == timeline.JobStatusRunning {
		if ev.Sticky && taskStatus == string(orchestrator.TaskStatusAwaiting) {
			// "parked" here feeds "timeline-row-job-" + ... (style.css), NOT
			// "badge-" + ... — it does not collide with the real task status
			// "parked" (cross-project-issue-triage Phase 1).
			return "parked"
		}
		return timeline.JobStatusRunning
	}
	if ev.Job != nil && ev.Job.Status != "" {
		return ev.Job.Status
	}
	return "default"
}

// timelineJobIdentity returns the label prefix used as the running-job label
// (no elapsed duration — that lives in a separate span so JS can tick it once
// per second). For hook jobs the "[hook]" prefix is omitted — the handler name
// alone identifies the hook. For all other roles the "[role] handler" form is
// used, falling back to just "[role]" when handler_id is empty.
func timelineJobIdentity(ev timeline.Event) string {
	if ev.Job == nil {
		return ""
	}
	role := ev.Job.Role
	if role == "" {
		role = "job"
	}
	if role == "hook" {
		name := ev.Job.DisplayName
		if name == "" {
			name = ev.Job.HandlerID
		}
		return name
	}
	if ev.Job.HandlerID != "" {
		return fmt.Sprintf("[%s] %s", role, ev.Job.HandlerID)
	}
	return fmt.Sprintf("[%s]", role)
}

// timelineJobSinceUnix returns the job's CreatedAt as a unix-seconds string
// for the data-since attribute on the dynamic-elapsed span. The client
// ticker reads it each second and rewrites the span's text; using unix
// seconds sidesteps timezone parsing in the browser.
func timelineJobSinceUnix(ev timeline.Event) string {
	if ev.Job == nil || ev.Job.CreatedAt.IsZero() {
		return ""
	}
	return fmt.Sprintf("%d", ev.Job.CreatedAt.Unix())
}

// TaskDetailTimelineSection renders the action-and-job history grouped by
// status visit. The grouping, sort, and label text are built by
// internal/timeline so the TUI and Web UI render the same structure. Shared
// verbatim by both the card and execution detail layouts (§7 罠2 — same
// #task-timeline id, same fragment kind=timeline in both).
//
// The awaiting call-to-action (TaskDetailAwaitingBanner) used to render at
// the top of this section; it moved to TaskDetailExecStatusSection's
// movement row (§3.1 部品A — exec's movement row is "状態+経過/awaitingバナー")
// so it surfaces immediately instead of only once the reader is already
// inside the (execution-only) Timeline tab, and so it does not render
// twice when Timeline is the default active tab.
//
// Layout: one continuous left rail across the whole timeline; each row
// (status header + events) sits on the rail with its own marker (○ for
// status header, ● for jobs with status color, ◆ for state-transition
// actions). Times right-align in a shared column, and the status header
// uses the same HH:MM:SS format as events so the eye finds them without
// re-parsing per row.
templ TaskDetailTimelineSection(task *orchestrator.Task, groups []timeline.StatusGroup, childTree []ChildTreeNode) {
	<div id="task-timeline" class="tab-content">
		@TaskDetailExecChildTreeSection(childTree)
		if len(groups) == 0 {
			<p class="tab-empty">(no history)</p>
		} else {
			<div class="timeline">
				for _, group := range groups {
					<div class={ "timeline-row", "timeline-row-header", "timeline-header-" + group.Status }>
						<time class="timeline-time">{ timelineGroupTime(group) }</time>
						<span class="timeline-marker timeline-marker-status" aria-hidden="true"></span>
						<span class={ taskStatusClass(group.Status) }>{ group.Status }</span>
					</div>
					for _, ev := range group.Events {
						if ev.Kind == timeline.KindJob && ev.Job != nil {
							<a class={ "timeline-row", "timeline-row-event", "timeline-row-job", "timeline-row-job-" + timelineJobStatusClass(ev, string(task.Status)), templ.KV("timeline-row-job-sticky", ev.Sticky) } href={ templ.SafeURL("/jobs/" + ev.Job.ID) }>
								if ev.Sticky {
									<time class="timeline-time timeline-time-sticky" aria-hidden="true">↻</time>
								} else {
									<time class="timeline-time">{ timelineEventTime(ev) }</time>
								}
								<span class="timeline-marker timeline-marker-job" aria-hidden="true"></span>
								if ev.Job.Status == timeline.JobStatusRunning {
									<span class="timeline-label">
										if ev.Sticky {
											if task.Status == orchestrator.TaskStatusAwaiting {
												{ timelineJobIdentity(ev) + " (parked, " }
											} else {
												{ timelineJobIdentity(ev) + " (継続中, " }
											}
											<span class="timeline-elapsed" data-since={ timelineJobSinceUnix(ev) }>{ timeline.FormatElapsed(ev.Job.CreatedAt) }</span>
											{ " ago)" }
										} else {
											{ timelineJobIdentity(ev) + " " }
											<span class="timeline-elapsed" data-since={ timelineJobSinceUnix(ev) }>{ timeline.FormatElapsed(ev.Job.CreatedAt) }</span>
											{ " ago" }
										}
									</span>
								} else {
									<span class="timeline-label">{ ev.Label }</span>
								}
								<span class="timeline-chevron" aria-hidden="true">›</span>
							</a>
						} else if ev.Action != nil && ev.Action.Type == "ask" {
							{{ qid := orchestrator.GetAwaitingPayload(ev.Action.Payload).QuestionID }}
							if qid != "" && task != nil && task.ParentID == "" {
								<a class="timeline-row timeline-row-event timeline-row-action timeline-row-ask" href={ templ.SafeURL("/tasks/" + task.ID + "/questions/" + qid) }>
									<time class="timeline-time">{ timelineEventTime(ev) }</time>
									<span class="timeline-marker timeline-marker-action" aria-hidden="true"></span>
									<span class="timeline-label">{ ev.Label }</span>
									<span class="timeline-chevron" aria-hidden="true">›</span>
								</a>
							} else {
								<div class="timeline-row timeline-row-event timeline-row-action">
									<time class="timeline-time">{ timelineEventTime(ev) }</time>
									<span class="timeline-marker timeline-marker-action" aria-hidden="true"></span>
									<span class="timeline-label">{ ev.Label }</span>
								</div>
							}
						} else if ev.Action != nil && ev.Action.Type == "progress" {
							<div class="timeline-row timeline-row-event timeline-row-progress">
								<time class="timeline-time">{ timelineEventTime(ev) }</time>
								<span class="timeline-marker timeline-marker-progress" aria-hidden="true"></span>
								<span class="timeline-label timeline-label-progress">{ ev.Label }</span>
							</div>
						} else {
							<div class="timeline-row timeline-row-event timeline-row-action">
								<time class="timeline-time">{ timelineEventTime(ev) }</time>
								<span class="timeline-marker timeline-marker-action" aria-hidden="true"></span>
								<span class="timeline-label">{ ev.Label }</span>
							</div>
						}
					}
				}
			</div>
		}
	</div>
}

// TaskDetailAwaitingBanner is the call-to-action shown at the top of the
// timeline tab when the task is in the awaiting state. It links to the
// dedicated Q&A page for the current question turn so the user can answer.
//
// Child tasks get the banner too. It used to be gated on `task.ParentID ==
// ""`, mirroring the ask notification's own "a supervisor will notice this"
// assumption — but a triage card runs no agent, so its children's questions
// had neither a notification nor a link. QuestionPage and POST
// /tasks/{id}/answer never carried the restriction, so the answer was always
// reachable by typing the URL; only the way in was missing. Whether anyone is
// watching decides whether to PAGE the user (fireUserAskNotification), not
// whether a page the user already opened should offer the form.
templ TaskDetailAwaitingBanner(task *orchestrator.Task) {
	{{ ap := orchestrator.GetAwaitingPayload(taskExecPayload(task)) }}
	if ap.QuestionID != "" {
		<a class="awaiting-banner" href={ templ.SafeURL("/tasks/" + task.ID + "/questions/" + ap.QuestionID) }>
			<span class="awaiting-banner-icon" aria-hidden="true">?</span>
			<span class="awaiting-banner-body">
				<span class="awaiting-banner-title">Question from agent</span>
				<span class="awaiting-banner-hint">Tap to open answer page</span>
			</span>
			<span class="awaiting-banner-chevron" aria-hidden="true">›</span>
		</a>
	}
}

// TaskDetailExecTabPanel renders the tab panel content for the given
// activeTab, on an execution task's detail page. id="tab-panel" is the HTMX
// swap target for tab switching. Card detail has no tabs (§7 罠1), so this
// (and the tab machinery around it) is execution-only.
//
// (死骸掃除, docs/plans/webui-detail-list-redesign.md §7 PR-1: this used to
// also take a `jobs []*JobView` parameter that flowed in from TaskDetail →
// TaskDetailTabsSection → here without ever being read — TaskDetailJobsSection,
// the only thing that would have consumed it, was never called from
// anywhere on the page. Both are gone now, along with fragment kind=jobs
// (internal/api/web.go).)
//
// TaskDetailLiveScript does NOT render here (Opus review, PR #996, B1):
// this whole <div id="tab-panel"> is inside #tabs, which HTMX swaps
// wholesale on every tab-link click — a <script> that lived in here used
// to get torn down and re-inserted on every switch, and the second
// insertion never actually re-subscribed (see TaskDetailLiveScript's own
// doc comment for the failure mode). The script is rendered exactly once,
// by TaskDetailExecBody, outside #tabs entirely.
templ TaskDetailExecTabPanel(task *orchestrator.Task, timelineGroups []timeline.StatusGroup, activeTab string, childTree []ChildTreeNode) {
	<div id="tab-panel" data-task-id={ task.ID }>
		if activeTab == "timeline" {
			@TaskDetailTimelineSection(task, timelineGroups, childTree)
		} else if activeTab == "description" {
			<div class="tab-content">
				if task.Description != "" {
					<div class="qa-md-body">
						@renderMarkdown(task.Description)
					</div>
				} else {
					<p class="tab-empty">(not set)</p>
				}
			</div>
		} else if activeTab == "payload" {
			<div class="tab-content">
				{{ yamlStr := payloadAsYAML(taskExecPayload(task)) }}
				if yamlStr != "" {
					<pre class="tab-body-pre">{ yamlStr }</pre>
				} else {
					<p class="tab-empty">(not set)</p>
				}
			</div>
		} else if activeTab == "instructions" {
			<div class="tab-content">
				if len(taskExecInstructions(task)) > 0 {
					for _, entry := range orderedInstructions(taskExecInstructions(task)) {
						{{ inst := entry.Instruction }}
						<section class="instr-block">
							<h3 class="instr-role">{ entry.Label }</h3>
							<div class="instr-meta">
								<span class="instr-kv"><span class="instr-k">agent</span>{ inst.Agent }</span>
								if inst.Model != "" {
									<span class="instr-kv"><span class="instr-k">model</span>{ inst.Model }</span>
								}
								if inst.Name != "" {
									<span class="instr-kv"><span class="instr-k">name</span>{ inst.Name }</span>
								}
							</div>
							if inst.Message != "" {
								<pre class="tab-body-pre instr-message">{ inst.Message }</pre>
							} else {
								<p class="tab-empty">(no message)</p>
							}
						</section>
					}
				} else {
					<p class="tab-empty">(not set)</p>
				}
			</div>
		}
	</div>
}

// tabClass returns the CSS class for a tab, adding "active" when it matches the current tab.
func tabClass(tab, activeTab string) string {
	if tab == activeTab {
		return "tab active"
	}
	return "tab"
}

// detailTabIsDropdown reports whether the active tab lives inside the
// "details" dropdown (description / payload / instructions). Timeline gets
// top-level real estate because it's the overwhelmingly most-used tab;
// everything else shares one dropdown whose label reflects the current
// selection (defaulting to "Description" — the landing spot when none is
// chosen). Execution-only — card detail has no tabs (§7 罠1).
func detailTabIsDropdown(activeTab string) bool {
	return activeTab != "timeline"
}

// detailDropdownActiveSub returns the (tab, label) pair that the
// dropdown's label link points at. When a sub-tab is active we keep the
// user there; otherwise we default to description so clicking the
// label always leads somewhere useful.
func detailDropdownActiveSub(activeTab string) (tab, label string) {
	switch activeTab {
	case "payload":
		return "payload", "Payload"
	case "instructions":
		return "instructions", "Instructions"
	default:
		return "description", "Description"
	}
}

func detailDropdownLabelClass(activeTab string) string {
	if detailTabIsDropdown(activeTab) {
		return "tab tab-dropdown-label active"
	}
	return "tab tab-dropdown-label"
}

templ detailTabLink(taskID, tab, label, activeTab string) {
	<a
		class={ tabClass(tab, activeTab) }
		href={ templ.SafeURL("/tasks/" + taskID + "?tab=" + tab) }
		hx-get={ "/tasks/" + taskID + "?tab=" + tab }
		hx-target="#tabs"
		hx-swap="outerHTML"
		hx-push-url="true"
	>{ label }</a>
}

templ detailMoreItem(taskID, tab, label, activeTab string) {
	<a
		class={ "tab-more-item", templ.KV("active", tab == activeTab) }
		href={ templ.SafeURL("/tasks/" + taskID + "?tab=" + tab) }
		hx-get={ "/tasks/" + taskID + "?tab=" + tab }
		hx-target="#tabs"
		hx-swap="outerHTML"
		hx-push-url="true"
	>{ label }</a>
}

// TaskDetailExecTabsSection wraps tab-list + tab-panel + action-bar under a
// single #tabs node, for an execution task's detail page (card detail has
// no tabs — §7 罠1). HTMX tab-link clicks swap this entire section so:
//   - the active class on the visible tabs updates
//   - the "more" details element is freshly rendered (closed by default,
//     summary label reflects the new active tab when it's a hidden one)
//   - the action bar primary button becomes tab-contextual without a separate swap
//
// This is also what GET /tasks/{id} renders directly (skipping Layout) when
// the request carries HX-Request: true and the task is NOT a card — see
// WebHandler.TaskDetail's own doc comment on the HX-Request branch for why
// a card never takes this path.
templ TaskDetailExecTabsSection(task *orchestrator.Task, timelineGroups []timeline.StatusGroup, availableActions []string, activeTab string, childTree []ChildTreeNode) {
	<div id="tabs" class="tabs">
		<div class="tab-list" role="tablist">
			@detailTabLink(task.ID, "timeline", "Timeline", activeTab)
			{{ subTab, subLabel := detailDropdownActiveSub(activeTab) }}
			<div class="tab-dropdown">
				<a
					class={ detailDropdownLabelClass(activeTab) }
					href={ templ.SafeURL("/tasks/" + task.ID + "?tab=" + subTab) }
					hx-get={ "/tasks/" + task.ID + "?tab=" + subTab }
					hx-target="#tabs"
					hx-swap="outerHTML"
					hx-push-url="true"
				>{ subLabel }</a>
				<details class="tab-dropdown-toggle-wrap">
					<summary class="tab-dropdown-toggle" aria-label="More tabs">
						<span aria-hidden="true">▾</span>
					</summary>
					<div class="tab-more-menu" role="menu">
						@detailMoreItem(task.ID, "description", "Description", activeTab)
						@detailMoreItem(task.ID, "payload", "Payload", activeTab)
						@detailMoreItem(task.ID, "instructions", "Instructions", activeTab)
					</div>
				</details>
			</div>
		</div>
		@TaskDetailExecTabPanel(task, timelineGroups, activeTab, childTree)
		@TaskExecActionBar(task, availableActions, activeTab)
	</div>
}

// TaskDetailLiveScript subscribes to /api/tasks/{id}/events (SSE) and keeps
// #task-status / #task-pinned / #task-timeline fresh, and ticks the "MM:SS
// ago" elapsed text on running-job rows. Shared verbatim by both the card
// and execution detail layouts (docs/plans/webui-detail-list-redesign.md §7
// 罠2 — both layouts render the same #task-status/#task-timeline ids and
// the same fragment kind=status/kind=timeline endpoints, so one copy of
// this script works for both) rather than duplicated per layout.
//
// kind=pinned only ever finds a #task-pinned element on a card layout — an
// execution page's fetch simply finds nothing to replace (refresh()'s own
// `if (el)` guard), the same tolerant no-op the shared kind=timeline id
// mismatch already relies on.
//
// Reads the task id off #task-status's data-task-id attribute — both
// TaskDetailCardStatusSection and TaskDetailExecStatusSection render that —
// rather than #tab-panel's (execution-only; the card layout has no
// tab-panel at all now that card detail has no tabs).
//
// Both callers (TaskDetailCardBody, TaskDetailExecBody) render this OUTSIDE
// anything HTMX ever swaps — TaskDetailExecBody renders it as a sibling of
// TaskDetailExecTabsSection's #tabs, not inside it (Opus review, PR #996,
// blocking finding B1). It used to live inside TaskDetailExecTabPanel
// (i.e. inside #tabs), paired with an htmx:beforeSwap teardown that closed
// the EventSource and removed its own listener whenever #tabs was about to
// be swapped (a tab-link click). That was a one-way trip: the top-of-IIFE
// `if (window.__boidTimelineSubscriber) return` guard is a MODULE-level
// flag that survives the swap, so when the freshly-swapped-in #tabs
// (rendered by the same TaskDetailExecTabPanel, still gated on
// activeTab=="timeline") re-inserted this same <script> and it ran again,
// the guard immediately returned before ever calling openES() again — the
// very first tab switch on an execution task's detail page silently killed
// live updates for the rest of the page's life. Rendering the script once,
// outside the swapped subtree, removes the reason the teardown existed in
// the first place: the script node itself is never removed, so there is no
// stale EventSource to close and no listener to re-attach — the
// __boidTimelineSubscriber/__boidTimelineTicker guards alone are enough to
// keep this idempotent across the (now impossible) case of the script
// somehow rendering twice.
templ TaskDetailLiveScript() {
	<div id="task-live-status" class="task-live-status" role="status" aria-live="polite">
		<span id="task-live-message">Connecting to live updates…</span>
		<button type="button" id="task-live-retry" class="btn btn-secondary btn-sm">Refresh status</button>
	</div>
	<script>
		(function() {
			if (window.__boidTimelineSubscriber) return;
			window.__boidTimelineSubscriber = true;

			var statusEl = document.getElementById('task-status');
			var taskID = statusEl ? statusEl.dataset.taskId : '';
			if (!taskID) return;

			var es = null;
			var connected = false;
			var failures = {};
			var requests = {};
			var lastUpdated = new Date();
			function showFreshness() {
				var box = document.getElementById('task-live-status');
				var message = document.getElementById('task-live-message');
				if (!box || !message) return;
				var stale = !connected || Object.keys(failures).length > 0;
				box.dataset.stale = stale ? 'true' : 'false';
				var time = lastUpdated.toLocaleTimeString([], { timeZoneName: 'short' });
				message.textContent = (stale ? 'Updates interrupted. Last retrieved ' : 'Live updates · Last retrieved ') + time;
			}
			function fetchHTML(url) {
				var key = url.replace(/frontier=[^&]*/, "frontier=").replace(/&operation=[^&]*/, "");
				if (requests[key]) requests[key].abort();
				var controller = new AbortController();
				requests[key] = controller;
				var timeout = setTimeout(function() { controller.abort(); }, 15000);
				return fetch(url, { signal: controller.signal, cache: 'no-store' })
					.then(function(r) {
						if (!r.ok || r.redirected) throw new Error('Unable to retrieve current state');
						return r.text();
					})
					.then(function(html) {
						if (requests[key] !== controller) return null;
						if (!html && url.indexOf('/fragment?') !== -1) throw new Error('Empty response');
						delete failures[key];
						lastUpdated = new Date();
						showFreshness();
						return html;
					})
					.catch(function() {
						if (requests[key] === controller) {
							failures[key] = true;
							showFreshness();
						}
						return null;
					})
					.finally(function() {
						clearTimeout(timeout);
						if (requests[key] === controller) delete requests[key];
					});
			}

			// captureSwapState/restoreSwapState preserve an open <details>
			// (keyed by its closest ancestor id plus its own class) and el's
			// own viewport-relative top position across an outerHTML
			// replace — only a guarantee about el itself, not scroll
			// position in general.
			function liveFocusKey(control) {
				if (!control) return '';
				var receipt = control.closest('[data-operation-id]');
				var prefix = receipt ? receipt.dataset.operationId + '|' : '';
				if (control.id) return prefix + 'id:' + control.id;
				if (control.tagName === 'A') return prefix + 'link:' + control.getAttribute('href');
				if (control.tagName === 'SUMMARY') return prefix + 'details:' + control.parentElement.className;
				if (control.form) {
					var hidden = Array.from(control.form.querySelectorAll('input[type="hidden"]'))
						.filter(function(input) { return input.name !== '_csrf'; })
						.map(function(input) { return [input.name, input.value]; });
					return prefix + JSON.stringify([control.tagName, control.name, control.value, control.form.getAttribute('action'), hidden]);
				}
				return '';
			}
			function captureSwapState(el) {
				var openKeys = [];
				el.querySelectorAll('details[open]').forEach(function(d) {
					var anchor = d.closest('[id]');
					if (anchor) openKeys.push(anchor.id + '|' + d.className);
				});
				var focused = document.activeElement;
				var operation = focused && el.contains && el.contains(focused) && focused.getAttribute('data-operation-id');
				return { openKeys: openKeys, top: el.getBoundingClientRect().top, focusedOperation: operation || '', focusKey: focused && el.contains && el.contains(focused) ? liveFocusKey(focused) : '' };
			}
			function restoreSwapState(el, state) {
				if (!el || !state) return;
				var keys = {};
				state.openKeys.forEach(function(k) { keys[k] = true; });
				el.querySelectorAll('details').forEach(function(d) {
					var anchor = d.closest('[id]');
					if (anchor && keys[anchor.id + '|' + d.className]) d.open = true;
				});
				if (state.focusKey) {
					var match = Array.from(el.querySelectorAll('a,button,input,textarea,summary')).find(function(control) { return liveFocusKey(control) === state.focusKey; });
					if (match) match.focus({ preventScroll: true });
				}
				if (state.focusedOperation) {
					var focused = el.querySelector('[data-operation-id="' + CSS.escape(state.focusedOperation) + '"]');
					if (focused) { focused.tabIndex = -1; focused.focus({ preventScroll: true }); }
				}
				var delta = el.getBoundingClientRect().top - state.top;
				if (delta !== 0) window.scrollBy(0, delta);
			}

			function refresh(kinds) {
				kinds.forEach(function(kind) {
					var before = document.getElementById('task-' + kind);
					if (!before) {
						var key = '/tasks/' + taskID + '/fragment?kind=' + kind;
						if (requests[key]) { requests[key].abort(); delete requests[key]; }
						delete failures[key];
						showFreshness();
						return;
					}
					var refreshURL = '/tasks/' + taskID + '/fragment?kind=' + kind;

					fetchHTML(refreshURL)
						.then(function(html) {
							if (!html) return;
							var before = document.getElementById('task-' + kind);
							if (!before) return;

							if (window.boidPreserveOperationResults) html = window.boidPreserveOperationResults(html);
							var state = captureSwapState(before);
							var el = before;
							el.outerHTML = html;
							restoreSwapState(document.getElementById('task-' + kind), state);
						})
						.catch(function() {});
				});
			}

			// refreshHistoryHead re-syncs #card-timeline's already-loaded
			// head range (top down through the current Load-older boundary,
			// read off that button's hx-get, or the whole thing when there
			// is none) in place, without touching pages loaded further back
			// — preserving <details> fold state the same way refresh() does.
			// No-op when #card-timeline is absent. See TaskCardTimelineHead
			// (internal/api/web.go) for the server side.
			function refreshHistoryHead() {
				// Single source for the head endpoint: two call sites below.
				function historyHeadURL(id, frontier) {
					return '/tasks/' + id + '/card-timeline/head?frontier=' + encodeURIComponent(frontier);
				}
				var container = document.getElementById('card-timeline');
				if (!container) return;
				var list = container.querySelector('.card-timeline-list');

				// No list yet (a brand new card, or one whose only item so
				// far was pinned) — fetch the head fresh and build the list
				// for the first time, replacing the "No history yet." copy.
				if (!list) {
					fetchHTML(historyHeadURL(taskID, ''))
						.then(function(html) {
							if (html === null) return;
							var tmp = document.createElement('template');
							tmp.innerHTML = html;
							if (!tmp.content.firstChild) return;
							var ul = document.createElement('ul');
							ul.className = 'card-timeline-list';
							while (tmp.content.firstChild) ul.appendChild(tmp.content.firstChild);
							var empty = container.querySelector('.tab-empty');
							if (empty) empty.remove();
							container.appendChild(ul);
						})
						.catch(function() {});
					return;
				}

				var boundaryEl = null;
				var frontier = '';
				var btn = list.querySelector('.card-timeline-load-older button');
				if (btn) {
					boundaryEl = btn.closest('li');
					try {
						var u = new URL(btn.getAttribute('hx-get'), window.location.href);
						frontier = u.searchParams.get('cursor') || '';
					} catch (e) {}
				} else {
					list.querySelectorAll('.card-timeline-date-sep').forEach(function(li) {
						if (!boundaryEl && li.textContent === 'No more history.') boundaryEl = li;
					});
				}

				// Captured/restored the same way refresh() does for
				// #task-status/#task-pinned — a history item's own
				// <details> fold (a child's spec) is exposed to the same
				// splice below, so it needs the same treatment.
				fetchHTML(historyHeadURL(taskID, frontier))
					.then(function(html) {
						if (html === null) return;
						// A "Load older" click may have already swapped
						// (and detached) boundaryEl while this fetch was in
						// flight — bail rather than empty the list or throw
						// on a stale insertBefore reference.
						if (boundaryEl && boundaryEl.parentNode !== list) return;
						if (window.boidPreserveOperationResults) html = window.boidPreserveOperationResults(html);
						var state = captureSwapState(list);
						var node = list.firstElementChild;
						while (node && node !== boundaryEl) {
							var next = node.nextElementSibling;
							list.removeChild(node);
							node = next;
						}
						var tmp = document.createElement('template');
						tmp.innerHTML = html;
						while (tmp.content.firstChild) {
							list.insertBefore(tmp.content.firstChild, boundaryEl);
						}
						restoreSwapState(list, state);
					})
					.catch(function() {});
			}

			function openES() {
				openEventStream(false);
			}
			function retryES() {
				openEventStream(true);
			}
			function openEventStream(retryConnecting) {
				if (es && es.readyState !== EventSource.CLOSED) {
					if (!retryConnecting || es.readyState === EventSource.OPEN) return;
					var oldStream = es;
					es = null;
					oldStream.close();
				}
				var stream = new EventSource('/api/tasks/' + taskID + '/events');
				es = stream;
				function currentStream(fn) {
					return function() {
						if (es !== stream) return;
						fn();
					};
				}
				stream.addEventListener('open', currentStream(function() {
					connected = true;
					showFreshness();
					refresh(['status', 'pinned', 'timeline', 'controls']);
					refreshHistoryHead();
				}));
				stream.addEventListener('error', currentStream(function() { connected = false; showFreshness(); }));
				stream.addEventListener('action', currentStream(function() { refresh(['status', 'pinned', 'timeline', 'controls']); refreshHistoryHead(); }));
				stream.addEventListener('job', currentStream(function() { refresh(['status', 'pinned', 'timeline', 'controls']); refreshHistoryHead(); }));
				stream.addEventListener('fired_event', currentStream(function() { refresh(['timeline']); }));
				// Child updates affect current activity and historical child rows.
				stream.addEventListener('child', currentStream(function() { refresh(['status', 'pinned', 'timeline', 'controls']); refreshHistoryHead(); }));
			}

			function closeES() {
				if (es) {
					var oldStream = es;
					es = null;
					oldStream.close();
				}
				connected = false;
				showFreshness();
			}

			document.addEventListener('htmx:afterSwap', function() {
				if (!document.getElementById('task-timeline')) {
					var key = '/tasks/' + taskID + '/fragment?kind=timeline';
					if (requests[key]) { requests[key].abort(); delete requests[key]; }
					delete failures[key];
					showFreshness();
				}
			});
			document.addEventListener('boid:operation-result', function() {
				refresh(['status', 'pinned', 'timeline', 'controls']);
				refreshHistoryHead();
			});
			document.getElementById('task-live-retry').addEventListener('click', function() {
				retryES();
				refresh(['status', 'pinned', 'timeline', 'controls']);
				refreshHistoryHead();
			});
			setInterval(function() {
				if (document.visibilityState !== 'hidden') {
					refresh(['status', 'pinned', 'timeline', 'controls']);
					refreshHistoryHead();
				}
			}, 30000);
			openES();

			// Live-tick the "MM:SS ago" text on running-job rows so
			// the user sees the elapsed counter advance in real time
			// instead of waiting for the next fragment refresh. The
			// tick iterates over whatever .timeline-elapsed[data-since]
			// nodes exist in the current DOM, so new rows added by a
			// refresh pick up the counter on the next tick without
			// re-wiring. Guarded by a window flag so repeated tab
			// swaps / re-renders don't stack extra intervals.
			if (!window.__boidTimelineTicker) {
				window.__boidTimelineTicker = true;
				function tickElapsed() {
					var now = Math.floor(Date.now() / 1000);
					document.querySelectorAll('.timeline-elapsed[data-since]').forEach(function(el) {
						var since = parseInt(el.dataset.since, 10);
						if (!since) return;
						var d = Math.max(0, now - since);
						var h = Math.floor(d / 3600);
						var m = Math.floor((d % 3600) / 60);
						var s = d % 60;
						var pad = function(n) { return (n < 10 ? '0' : '') + n; };
						el.textContent = h > 0
							? (pad(h) + ':' + pad(m) + ':' + pad(s))
							: (pad(m) + ':' + pad(s));
					});
				}
				tickElapsed();
				setInterval(tickElapsed, 1000);
			}

			window.addEventListener('pagehide', closeES);
			document.addEventListener('visibilitychange', function() {
				if (document.visibilityState === 'hidden') {
					closeES();
				} else {
					openES();
					refresh(['status', 'pinned', 'timeline', 'controls']);
					refreshHistoryHead();
				}
			});
			window.addEventListener('pageshow', function(e) {
				openES();
				refresh(['status', 'pinned', 'timeline', 'controls']);
				refreshHistoryHead();
			});
		})();
	</script>
}

func operationResultText(result *orchestrator.OperationResult) string {
	switch result.ReasonCode {
	case orchestrator.OperationReasonSuggestionAcceptedLaunchRejected:
		return "The suggestion was accepted, but its execution did not start. Review the current card state before trying again."
	case orchestrator.OperationReasonSuggestionAcceptedLaunchUnknown:
		return "The suggestion was accepted, but the server could not confirm whether its execution started. Check the current state before trying again."
	}
	if result.Result == orchestrator.OperationResultUnknown {
		return "The server could not confirm the complete outcome. Check the linked work and refresh the current state before trying again."
	}
	switch result.CurrentPhase {
	case orchestrator.OperationReasonRequestFailed:
		if result.TargetTaskID != "" || result.TargetSessionID != "" {
			return "The operation started, but its destination later failed or stopped. Review the linked work before trying again."
		}
		return "The request was accepted, but its launch later failed. Review the current card state before trying again."
	case orchestrator.OperationReasonTargetStarted:
		return "The accepted operation started."
	}
	switch result.ReasonCode {
	case orchestrator.OperationReasonSlotOccupied:
		return "Another operation is using the execution slot. This operation was not accepted or queued."
	case orchestrator.OperationReasonNoReadyWork:
		return "There is no ready work to start. This operation was not accepted or queued."
	case orchestrator.OperationReasonNotAvailable:
		return "The current card state does not allow this operation. It was not accepted or queued."
	}
	switch result.Result {
	case orchestrator.OperationResultStarted:
		return "The operation started."
	case orchestrator.OperationResultAccepted:
		return "The operation was accepted. Its task or session may be linked when it starts."
	default:
		return "The operation was not accepted and was not queued."
	}
}

func operationResultLabel(result *orchestrator.OperationResult) string {
	if result.OperationLabel != "" {
		return result.OperationLabel
	}
	if result.OperationType == "go" {
		return "Go"
	}
	return "Card command"
}

// Compatibility fragment: operation rows use the timeline's item renderer.
templ OperationResultsSection(results []*orchestrator.OperationResult) {
	<ul id="task-operations" class="card-timeline-list">
		for _, result := range results {
			@CardTimelineItem(timeline.OperationCardItem(result), result.TaskID, "", false, "")
		}
	</ul>
}

templ operationResultBody(result *orchestrator.OperationResult) {
	<div class="operation-result-head">
		<strong>{ operationResultLabel(result) }</strong>
		<span class={ "badge", "badge-" + result.Result }>{ result.Result }</span>
	</div>
	<p>{ operationResultText(result) }</p>
	if result.Notice != "" {
		<p class="operation-result-notice">{ result.Notice }</p>
	}
	<div class="operation-result-links">
		if result.TargetTaskID != "" {
			if result.TargetTaskUnavailable {
				<span>Task is no longer available.</span>
			} else {
				<a href={ templ.SafeURL("/tasks/" + result.TargetTaskID) }>Open task</a>
			}
		}
		if result.TargetSessionID != "" {
			if result.TargetSessionUnavailable {
				<span>Session is no longer available.</span>
			} else {
				<a href={ templ.SafeURL("/jobs/" + result.TargetSessionID) }>Open session</a>
			}
		}
	</div>
	<details class="operation-result-diagnostics">
		<summary>Diagnostic details</summary>
		<dl>
			<dt>Type</dt>
			<dd><code>{ result.OperationType }</code></dd>
			<dt>Result</dt>
			<dd><code>{ result.Result }</code></dd>
			<dt>Reason</dt>
			<dd><code>{ result.ReasonCode }</code></dd>
			if result.CurrentPhase != "" {
				<dt>Current phase</dt>
				<dd><code>{ result.CurrentPhase }</code></dd>
			}
			if result.TargetTaskID != "" {
				<dt>Task</dt>
				<dd><code>{ result.TargetTaskID }</code></dd>
			}
			if result.TargetSessionID != "" {
				<dt>Session</dt>
				<dd><code>{ result.TargetSessionID }</code></dd>
			}
			if result.TargetRequestID != "" {
				<dt>Request</dt>
				<dd><code>{ result.TargetRequestID }</code></dd>
			}
		</dl>
	</details>
}

// TaskDetailCardBody assembles a card detail page's content, top to bottom:
// meta followed by summary and expandable description, command input, a
// unified timeline, then the footer controls. No tabs — see §7 罠1.
//
// TaskDetailLiveScript renders here, at the body level — nothing on the
// card layout ever gets HTMX-swapped, so there is no risk of the script
// node itself being removed and reinserted (the failure mode TaskExecBody's
// own doc comment below describes). TaskDetailExecBody mirrors this
// placement (also body-level, also outside anything swappable) precisely
// so both layouts follow the same rule: the live script is rendered once,
// never inside a swap target.
templ TaskDetailCardBody(task *orchestrator.Task, availableActions []string, errorMsg string, projectName string, summary string, tl *CardTimelineView, cmdOptions []CardCommandOption, cmdForm *CardCommandFormState, identities []apiwire.TaskIdentity, operationResults []*orchestrator.OperationResult) {
	@TaskDetailCardStatusSection(task, errorMsg, projectName, summary, identities)
	{{ view := cardTimelineWithOperations(tl, operationResults) }}
	@CardCommandSection(task.ID, task.Status, cmdOptions, cmdForm)
	<section class="card-timeline" aria-label="Timeline">
		<h2 class="detail-section-title">Timeline</h2>
		<div class="card-timeline-tz">Times shown in { cardTimelineTZLabel() }</div>
		<div id="operation-submit-feedback" role="status" aria-live="polite" tabindex="-1" hidden></div>
		@TaskDetailCardPinnedSection(view, task.ID, task.Status)
		@CardHistorySection(view, task.ID)
	</section>
	@TaskCardActionBar(task, availableActions, view)
	@TaskDetailLiveScript()
}

// TaskDetailExecBody assembles an execution task detail page's content
// (§3.4 item 1 — meta; item 2 — direct children; items 3-5 — the
// existing tab structure is kept as-is).
//
// TaskDetailLiveScript renders here, as a sibling AFTER
// TaskDetailExecTabsSection — deliberately outside the #tabs node HTMX
// swaps on every tab-link click (Opus review, PR #996, blocking finding
// B1). It used to render inside TaskDetailExecTabPanel (inside #tabs) with
// an htmx:beforeSwap teardown that closed the EventSource whenever #tabs
// was about to be swapped; the very first tab click tore the connection
// down and the script's own top-of-IIFE re-entry guard then silently
// prevented the freshly-swapped-in copy from ever reopening it — SSE
// updates died permanently after one tab switch. Rendering it once here
// means #tabs can swap as much as it wants; the script node itself is
// never touched.
templ TaskDetailExecBody(task *orchestrator.Task, timelineGroups []timeline.StatusGroup, availableActions []string, errorMsg string, activeTab string, projectName string, childTree []ChildTreeNode, identities []apiwire.TaskIdentity) {
	@TaskDetailExecStatusSection(task, errorMsg, projectName, childTree, identities)
	@TaskDetailExecTabsSection(task, timelineGroups, availableActions, activeTab, childTree)
	@TaskDetailLiveScript()
}

// TaskDetail is the task detail page's single entry point — one URL
// (/tasks/{id}) for both entities, layout selected by task.Type (the same
// axis machineFor uses): a card gets TaskDetailCardBody ("判断の場" —
// status + pinned items + body text are the main content, timeline history
// is secondary), anything else gets TaskDetailExecBody ("プロセスの観測窓" —
// the status-group timeline stays the main content, via the existing tab
// structure).
templ TaskDetail(task *orchestrator.Task, timelineGroups []timeline.StatusGroup, availableActions []string, errorMsg string, activeTab string, projectName string, cardSummary string, cardTL *CardTimelineView, childTree []ChildTreeNode, cmdOptions []CardCommandOption, cmdForm *CardCommandFormState, identities []apiwire.TaskIdentity, operationResults []*orchestrator.OperationResult) {
	@Layout(task.Title, taskDetailBackURL(task)) {
		if task.Type == orchestrator.TaskTypeCard {
			@TaskDetailCardBody(task, availableActions, errorMsg, projectName, cardSummary, cardTL, cmdOptions, cmdForm, identities, operationResults)
		} else {
			@TaskDetailExecBody(task, timelineGroups, availableActions, errorMsg, activeTab, projectName, childTree, identities)
		}
	}
}

func taskDetailBackURL(task *orchestrator.Task) string {
	if task != nil && task.ParentID != "" {
		return "/tasks/" + task.ParentID
	}
	return "/"
}

templ TaskChildSpecDetail(parent *orchestrator.Task, child orchestrator.TaskTriageChild, referencedTaskMissing bool, result string, resultStatus orchestrator.TaskStatus, hasResult bool) {
	{{ title := child.Title }}
	if title == "" {
		{{ title = child.ID }}
	}
	@Layout(title, "/tasks/"+parent.ID) {
		<section class="child-spec-detail">
			<div class="detail-meta">
				<span class={ "badge", "badge-" + child.Status }>{ child.Status }</span>
				if child.Spec != nil && child.Spec.Behavior != "" {
					<span class="badge badge-child-behavior">{ child.Spec.Behavior }</span>
				}
			</div>
			if referencedTaskMissing {
				<p class="child-spec-notice">The execution task is no longer available. The saved specification remains below.</p>
			} else if child.Spec == nil {
				<p class="child-spec-notice">The specification is not ready yet.</p>
			}
			if child.Spec != nil {
				<dl class="child-spec-fields">
					<dt>Project</dt>
					<dd>{ child.Spec.Project }</dd>
					<dt>Behavior</dt>
					<dd>{ child.Spec.Behavior }</dd>
					<dt>Description</dt>
					<dd class="qa-md-body">
						@renderMarkdown(child.Spec.Description)
					</dd>
					<dt>Instruction</dt>
					<dd><pre class="tab-body-pre">{ child.Spec.Instruction }</pre></dd>
				</dl>
			}
			if hasResult {
				<section class="child-spec-result">
					<h2>Result</h2>
					<span class={ taskStatusClass(string(resultStatus)) }>{ string(resultStatus) }</span>
					if result != "" {
						<div class="qa-md-body">
							@renderMarkdown(result)
						</div>
					}
				</section>
			}
		</section>
	}
}

// TaskEditPage renders the dedicated edit form for a pending task.
// All four fields (title / project / description / instructions) are
// shown on one page; Save POSTs to /tasks/{id}/edit.
templ TaskEditPage(task *orchestrator.Task, projects []*orchestrator.Project, errorMsg string) {
	@Layout("Edit: "+task.Title, "/tasks/"+task.ID) {
		if errorMsg != "" {
			<div class="action-error">{ errorMsg }</div>
		}
		<div class="task-form-body">
			<form id="task-edit-form" method="post" action={ templ.SafeURL("/tasks/" + task.ID + "/edit") }>
				<div class="form-group">
					<label class="form-label">Title</label>
					<input type="text" name="title" value={ task.Title } class="form-input" required autofocus/>
				</div>
				<div class="form-group">
					<label class="form-label">Project</label>
					<select name="project_id" class="form-input">
						<option value="">— no project —</option>
						for _, p := range projects {
							if p.ID == task.ProjectID {
								<option value={ p.ID } selected>{ projectOptionLabel(p) }</option>
							} else {
								<option value={ p.ID }>{ projectOptionLabel(p) }</option>
							}
						}
					</select>
				</div>
				<div class="form-group">
					<label class="form-label">Remote ID</label>
					<input type="text" name="remote_id" class="form-input" autocomplete="off" value={ task.RemoteID }/>
				</div>
				<div class="form-group">
					<label class="form-label">Description</label>
					<textarea name="description" class="form-input" rows="8">{ task.Description }</textarea>
				</div>
				{{ active := taskExecInstructions(task).Active() }}
				<div class="form-group">
					<label class="form-label">Message</label>
					<textarea name="message" class="form-input tab-edit-textarea" rows="8" placeholder="指示メッセージ">{ instrActiveField(active, "message") }</textarea>
				</div>
				<div class="form-group">
					<label class="form-label">Model</label>
					<input type="text" name="model" class="form-input" placeholder="opus / sonnet / haiku" value={ instrActiveField(active, "model") }/>
				</div>
				<div class="form-group">
					<label class="form-label">Agent</label>
					<input type="text" name="agent" class="form-input" placeholder="claude-code" value={ instrActiveField(active, "agent") }/>
				</div>
			</form>
		</div>
		<div class="action-bar">
			<div class="action-bar-inner">
				<button type="submit" form="task-edit-form" class="btn btn-primary action-bar-primary-form">Save</button>
				<a href={ templ.SafeURL("/tasks/" + task.ID) } class="btn btn-secondary">Cancel</a>
			</div>
		</div>
	}
}
