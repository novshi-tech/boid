package templates

// AuthConfirm is the landing page for a magic link / QR scan. The token is
// carried in a form and spent only when the human presses the button, so a
// browser preload or a link preview cannot burn the one-time pairing code
// before the human arrives. Plain form POST (no JS, no CSRF token) on purpose:
// /auth is CSRF-exempt because the pairing token IS the credential, and the
// page has to work in whatever in-app browser the QR scanner opened.
templ AuthConfirm(token string) {
	@Layout("Login", "") {
		<div class="login-container">
			<h1 class="login-title">Device Authentication</h1>
			<p>このデバイスを boid に登録します。</p>
			<form id="auth-confirm-form" class="login-form" method="post" action="/auth">
				<input type="hidden" name="token" value={ token }/>
				<div class="form-group">
					<label class="form-label">Pairing Code</label>
					<p class="login-code">{ token }</p>
				</div>
				<button type="submit" class="btn btn-primary">このデバイスを登録</button>
			</form>
			<p class="login-hint">
				コードは 1 回だけ、発行から 5 分間だけ使えます。
				失敗したら <code>boid web pair</code> で発行し直してください。
			</p>
		</div>
	}
}
