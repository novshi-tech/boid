package components

// Terminal renders an xterm.js-backed PTY widget.
// jobId is the job UUID; wsPath is the WebSocket API path (e.g. /api/jobs/{id}/attach/ws).
// The component is self-contained: it loads xterm.js, addon-fit.mjs, and
// boid-terminal.js, then initialises the terminal on DOMContentLoaded.
templ Terminal(jobId string, wsPath string) {
	<link rel="stylesheet" href="/static/assets/xterm-5.x/xterm.css"/>
	<script src="/static/assets/xterm-5.x/xterm.js"></script>
	<div
		class="boid-terminal"
		data-job-id={ jobId }
		data-ws-url={ wsPath }
	>
		<div class="boid-terminal-status-bar">
			<span class="boid-terminal-status boid-terminal-status-connecting" title="接続中"></span>
		</div>
		<div class="boid-terminal-xterm-wrap">
			<div class="boid-terminal-xterm"></div>
			<div class="boid-terminal-disconnect-overlay" hidden>
				<div class="boid-terminal-disconnect-content">
					<p class="boid-terminal-disconnect-msg">接続が切断されました</p>
					<button type="button" class="btn btn-primary boid-terminal-reconnect">再接続</button>
				</div>
			</div>
			// Copy toast. Shown when the user selects terminal text; clicking it puts
			// that text on the clipboard. This is the only copy path available while a
			// TUI has mouse reporting enabled — xterm.js wipes the selection when the
			// mouseup is forwarded to the application, so by the time the user could
			// reach for Ctrl+C the highlight (and term.getSelection()) is already gone.
			// The click also supplies the user gesture navigator.clipboard.writeText
			// requires on Safari/iOS. Positioned absolutely inside the xterm wrap so
			// showing it never changes the terminal's row count (a reflow would trigger
			// scheduleFit and, on a column change, term.reset()).
			<div class="boid-terminal-copy-toast" hidden>
				<button type="button" class="boid-terminal-copy-btn">
					<span class="boid-terminal-copy-label">コピー</span>
					<span class="boid-terminal-copy-preview"></span>
				</button>
				<button type="button" class="boid-terminal-copy-dismiss" aria-label="閉じる">×</button>
			</div>
		</div>
		<div class="boid-terminal-keybar">
			<button type="button" class="boid-terminal-keybar-btn" data-key="esc">Esc</button>
			<button type="button" class="boid-terminal-keybar-btn" data-key="tab">Tab</button>
			<button type="button" class="boid-terminal-keybar-btn" data-key="up">↑</button>
			<button type="button" class="boid-terminal-keybar-btn" data-key="down">↓</button>
			<button type="button" class="boid-terminal-keybar-btn" data-key="left">←</button>
			<button type="button" class="boid-terminal-keybar-btn" data-key="right">→</button>
			<button type="button" class="boid-terminal-keybar-btn boid-terminal-keybar-ctrl" data-key="ctrl">Ctrl</button>
		</div>
	</div>
	<script type="module" src={ "/static/boid-terminal-init.js?v=" + BuildID }></script>
}
