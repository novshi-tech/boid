package components

import "github.com/novshi-tech/boid/internal/orchestrator"

// projectLabel returns the display name for a project, falling back to ID
// when the meta name is missing.
func projectLabel(p *orchestrator.Project) string {
	if p.Meta.Name != "" {
		return p.Meta.Name
	}
	return p.ID
}

// TaskFilters renders the task list toolbar (docs/plans/
// webui-detail-list-redesign.md PR-4, §3.5): the 4-tab status switcher
// (Open/Closed/Queue/Parked, statusTab/statusTabActive) is GONE — the list
// no longer has separate tabbed views to switch between. In its place is a
// single 「アクティブのみ」(active-only) checkbox toggle (filter.ActiveOnly)
// — unchecked (the default, no query param) shows every status, checked
// narrows to non-terminal tasks. filter.Status itself is preserved as a
// hidden field only when a caller arrived with an explicit status (a
// bookmark, or an API-style deep link); the toolbar itself no longer writes
// one.
//
//   - active-only toggle (see above)
//   - search as a standalone input (its own hx-target avoids losing focus on each keystroke)
//   - workspace > project as one logical filter group
//
// Behavior is intentionally not exposed here — it was low-traffic in
// practice and shown on each task row instead. Its URL param still
// works so existing bookmarks keep narrowing the list.
//
// Create lives in the sticky bottom action bar (TaskListActionBar),
// keeping the toolbar focused on filtering.
templ TaskFilters(filter orchestrator.TaskFilter, projects []*orchestrator.Project, workspaces []*orchestrator.WorkspaceSummary) {
	<form
		id="filter-form"
		class="task-toolbar"
		hx-get="/"
		hx-target="#main-content"
		hx-swap="innerHTML"
		hx-select="#main-content"
		hx-push-url="true"
		hx-trigger="change"
	>
		if filter.Status != "" {
			<input type="hidden" name="status" value={ filter.Status }/>
		}
		<label class="active-only-toggle">
			<input type="checkbox" name="active" value="1" checked?={ filter.ActiveOnly }/>
			アクティブのみ
		</label>
		<input
			type="search"
			name="q"
			value={ filter.Title }
			placeholder="検索..."
			class="filter-search"
			autocomplete="off"
			aria-label="タイトル検索"
			hx-get="/"
			hx-trigger="input delay:300ms, search"
			hx-target="#task-list"
			hx-swap="outerHTML"
			hx-select="#task-list"
			hx-include="closest form"
			hx-push-url="true"
		/>
		if len(workspaces) > 0 || len(projects) > 0 {
			<div class="filter-group">
				if len(workspaces) > 0 {
					<select name="workspace" class="filter-select" aria-label="Workspace">
						<option value="">Workspace</option>
						for _, ws := range workspaces {
							if ws.ID == filter.WorkspaceID {
								<option value={ ws.ID } selected>{ ws.ID }</option>
							} else {
								<option value={ ws.ID }>{ ws.ID }</option>
							}
						}
					</select>
				}
				if len(projects) > 0 {
					<select name="project" class="filter-select" aria-label="Project">
						<option value="">Project</option>
						for _, p := range projects {
							if p.ID == filter.ProjectID {
								<option value={ p.ID } selected>{ projectLabel(p) }</option>
							} else {
								<option value={ p.ID }>{ projectLabel(p) }</option>
							}
						}
					</select>
				}
			</div>
		}
		if filter.Behavior != "" {
			<input type="hidden" name="behavior" value={ filter.Behavior }/>
		}
	</form>
}
