package components

import (
	"fmt"
	"github.com/novshi-tech/boid/internal/orchestrator"
)

// TreeItem is a task positioned in the display tree.
type TreeItem struct {
	Task        *orchestrator.Task
	Depth       int
	HasChildren bool
	ParentID    string // visual parent ID; empty for roots
	ProjectName string // resolved display name; falls back to ProjectID
	// Urgency / Summary are cross-project-issue-triage Phase 1 PR-3
	// task_triage sidecar fields (docs/plans/cross-project-issue-triage.md
	// queue 節 「文脈同梱: 1項目 = 1判断」), populated only for the queue_next
	// view (internal/api.BuildQueueItems) — empty for every other view, so
	// the badge/summary line below simply doesn't render there.
	Urgency string
	Summary string
	// Children is task_triage.detail.children (open/specced/dispatched/
	// closed sub-tasks), populated only for the queue_next view like
	// Urgency/Summary above. Gives a "what happens if I press Go" preview
	// right in the queue row instead of only on the task detail page —
	// nose flagged after the Shape launcher's first real dispatch that a
	// specced-vs-not distinction existed nowhere in the Web UI
	// (cross-project-issue-triage 実地テスト, 2026-08-14).
	Children []orchestrator.TaskTriageChild
	// Suggestion is task_triage.detail.suggestion (or detail.attrs.
	// suggestion — orchestrator.DetailSuggestion), populated for the
	// queue_next view (BuildQueueItems) and the Parked tab
	// (BuildTreeItemsWithSuggestions). Zero value everywhere else, so the
	// verb badge/reason line below simply doesn't render there.
	Suggestion orchestrator.Suggestion
}

func (i TreeItem) ProjectLabel() string {
	if i.ProjectName != "" {
		return i.ProjectName
	}
	return i.Task.ProjectID
}

func treeStatusClass(s string) string {
	return "badge badge-" + s
}

// knownSuggestionVerbs is the single source of truth for suggestion.verb's
// UI vocabulary (go/shape/manual/park/drop/wake — nose's own response
// words, orchestrator.Suggestion's doc comment). Deliberately NOT
// orchestrator.promotedAttrVocabulary: that guard exists so the daemon can
// trust its own SQL predicates against attrs_set writes (see its doc
// comment) — verb is neither a stored column nor a query target, and the
// daemon does not interpret/judge suggestions at all (決定12). An unknown
// verb is therefore a UI-only rendering concern, handled by VerbBadgeClass
// below rather than by validating/rejecting the value anywhere upstream.
var knownSuggestionVerbs = map[string]bool{
	"go":     true,
	"shape":  true,
	"manual": true,
	"park":   true,
	"drop":   true,
	"wake":   true,
}

// VerbBadgeClass maps a suggestion.verb to its badge CSS class (style.css).
// Kept in exactly one place and called from both rendering sites — the
// queue/Parked tab row (taskTreeRow below) and the task detail page's
// suggestion section (web/templates/tasks.templ's
// TaskDetailSuggestionSection) — so a future 7th verb, or a change to the
// unknown-verb fallback, only needs updating here (BD-8 残件4). An unknown
// verb still gets a class (badge-verb-unknown, style.css) rather than no
// badge at all: the verb text itself always renders regardless (rule 5,
// 隠さない) — only the color is what falls back to neutral gray.
func VerbBadgeClass(verb string) string {
	if !knownSuggestionVerbs[verb] {
		return "badge-verb-unknown"
	}
	return "badge-verb-" + verb
}

// childrenPreviewLabel summarizes a queue row's children into a compact
// "N specced, M open" string for the queue list — a preview of what
// pressing Go actually dispatches (only specced children task-ify;
// TaskWorkflowService.Dispatch, internal/api/workflow_triage.go). Omits a
// status entirely once its count is zero, so a fully-specced card just
// reads "N specced" instead of "N specced, 0 open".
func childrenPreviewLabel(children []orchestrator.TaskTriageChild) string {
	var specced, open, other int
	for _, c := range children {
		switch c.Status {
		case orchestrator.TaskTriageChildStatusSpecced:
			specced++
		case orchestrator.TaskTriageChildStatusOpen:
			open++
		default:
			other++
		}
	}
	label := ""
	if specced > 0 {
		label += fmt.Sprintf("%d specced", specced)
	}
	if open > 0 {
		if label != "" {
			label += ", "
		}
		label += fmt.Sprintf("%d open", open)
	}
	if label == "" && other > 0 {
		label = fmt.Sprintf("%d children", len(children))
	}
	return label
}

// TaskTree renders a flat list of TreeItems as a collapsible task tree.
// Folded state is persisted in localStorage.
templ TaskTree(items []TreeItem) {
	<div class="task-list" id="task-tree" role="list">
		for _, item := range items {
			@taskTreeRow(item)
		}
	</div>
	<script>
		(function() {
			var PREFIX = 'boid:tree:folded:';
			function isFolded(id) {
				return localStorage.getItem(PREFIX + id) === '1';
			}
			function isAncestorFolded(taskId) {
				var el = document.querySelector('#task-tree [data-task-id="' + taskId + '"]');
				while (el) {
					var pid = el.dataset.parentId;
					if (!pid) return false;
					if (isFolded(pid)) return true;
					el = document.querySelector('#task-tree [data-task-id="' + pid + '"]');
				}
				return false;
			}
			function applyVisibility() {
				document.querySelectorAll('#task-tree [data-task-id]').forEach(function(el) {
					if (!el.dataset.parentId) return;
					el.style.display = isAncestorFolded(el.dataset.taskId) ? 'none' : '';
				});
			}
			function applyIcons() {
				document.querySelectorAll('#task-tree .tree-fold-btn').forEach(function(btn) {
					var folded = isFolded(btn.dataset.taskId);
					btn.setAttribute('aria-expanded', folded ? 'false' : 'true');
					var down = btn.querySelector('.tree-fold-icon-down');
					var right = btn.querySelector('.tree-fold-icon-right');
					if (down) down.style.display = folded ? 'none' : '';
					if (right) right.style.display = folded ? 'inline-block' : 'none';
				});
			}
			function init() {
				applyVisibility();
				applyIcons();
				document.querySelectorAll('#task-tree .tree-fold-btn').forEach(function(btn) {
					btn.addEventListener('click', function(e) {
						e.preventDefault();
						e.stopPropagation();
						var id = btn.dataset.taskId;
						if (isFolded(id)) {
							localStorage.removeItem(PREFIX + id);
						} else {
							localStorage.setItem(PREFIX + id, '1');
						}
						applyVisibility();
						applyIcons();
					});
				});
			}
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', init);
			} else {
				init();
			}
		})();
	</script>
}

// taskTreeRow renders one task as a flat list item, with depth-based
// indentation. Tree guide lines are drawn via CSS using the --depth var.
//
// Blocked pending tasks (waiting on unsatisfied deps) get an extra
// `task-row-blocked` class so CSS can dim the row.
templ taskTreeRow(item TreeItem) {
	<a
		href={ templ.SafeURL("/tasks/" + item.Task.ID) }
		class={ "task-row", "task-row-status-" + string(item.Task.Status), templ.KV("task-row-blocked", item.Task.Blocked) }
		data-task-id={ item.Task.ID }
		data-parent-id={ item.ParentID }
		role="listitem"
		style={ fmt.Sprintf("--depth: %d", item.Depth) }
	>
		if item.HasChildren {
			<button
				type="button"
				class="tree-fold-btn"
				data-task-id={ item.Task.ID }
				aria-label="折りたたみ切替"
				aria-expanded="true"
			>
				@IconChevronDown("tree-icon tree-fold-icon-down")
				@IconChevronRight("tree-icon tree-fold-icon-right")
			</button>
		}
		<div class="task-row-body">
			<div class="task-row-title" title={ item.Task.Title }>{ item.Task.Title }</div>
			if item.Summary != "" {
				<div class="task-row-summary">{ item.Summary }</div>
			}
			if item.Suggestion.Reason != "" {
				<div class="task-row-summary">{ item.Suggestion.Reason }</div>
			}
			<div class="task-row-meta">
				<span class={ treeStatusClass(string(item.Task.Status)) }>{ string(item.Task.Status) }</span>
				if item.Urgency != "" {
					<span class={ "badge", "badge-urgency-" + item.Urgency }>{ item.Urgency }</span>
				}
				if item.Suggestion.Verb != "" {
					<span class={ "badge", VerbBadgeClass(item.Suggestion.Verb) }>{ item.Suggestion.Verb }</span>
				}
				if label := childrenPreviewLabel(item.Children); label != "" {
					<span class="task-row-children" title="What Go dispatches: only specced children task-ify">{ label }</span>
				}
				if item.Task.Status == orchestrator.TaskStatusAwaiting && item.Task.ParentID == "" {
					<span class="badge badge-call-to-action">Needs answer</span>
				}
				if item.Task.ProjectID != "" {
					<span class="task-row-project">{ item.ProjectLabel() }</span>
				}
				if item.Task.Behavior != "" {
					<span class="task-row-behavior">{ item.Task.Behavior }</span>
				}
			</div>
		</div>
	</a>
}
