package templates

import (
    "fmt"
	"net/url"
	"sort"

	"github.com/novshi-tech/boid/internal/orchestrator"
)

// taskNewProjectLabel returns the display name shown in the Project
// dropdown. Meta.Name is the human label (e.g. "boid", "freee-cli"); the
// raw project ID is only surfaced when a project lacks a name.
func taskNewProjectLabel(p *orchestrator.Project) string {
	if orchestrator.IsDefaultMetaproject(p) { return "Default" }
	if p.Meta.Name != "" {
		return p.Meta.Name
	}
	return p.ID
}

// Card creation chooses a workspace and its judgment project. Execution tasks
// continue to be created through the CLI/API and card Go flow.
func cardFormWorkspace(form url.Values) string {
    if ws := form.Get("workspace"); ws != "" { return ws }
    return orchestrator.DefaultWorkspaceSlug
}

func cardFormProject(form url.Values) string {
    if id := form.Get("project_id"); id != "" { return id }
    return orchestrator.DefaultMetaprojectID(cardFormWorkspace(form))
}

func cardFormWorkspaces(projects []*orchestrator.Project) []string {
    seen := map[string]bool{}
    var result []string
    for _, p := range projects {
        if !seen[p.WorkspaceID] { seen[p.WorkspaceID] = true; result = append(result, p.WorkspaceID) }
    }
    sort.Strings(result)
    return result
}

templ TaskNew(projects []*orchestrator.Project, errorMsg string, form url.Values) {
    @Layout("New Card", "/") {
        if errorMsg != "" {
            <div class="action-error">{ errorMsg }</div>
        }
        <div class="task-form-body">
            <form id="task-new-form" method="post" action="/tasks" enctype="multipart/form-data" data-paste-attach-form>
                <div class="form-group">
                    <label for="title" class="form-label">Title *</label>
                    <input type="text" id="title" name="title" class="form-input" required autocomplete="off" autofocus value={ form.Get("title") }/>
                </div>
                <div class="form-group">
                    <label for="workspace" class="form-label">Workspace</label>
                    <select id="workspace" name="workspace" class="form-input" required>
                        for _, ws := range cardFormWorkspaces(projects) {
                            <option value={ ws } selected?={ cardFormWorkspace(form) == ws }>{ ws }</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="project_id" class="form-label">Metaproject</label>
                    <select id="project_id" name="project_id" class="form-input" required>
                        for _, p := range projects {
                            <option value={ p.ID } data-workspace={ p.WorkspaceID } data-default={ fmt.Sprint(orchestrator.IsDefaultMetaproject(p)) } selected?={ cardFormProject(form) == p.ID } disabled?={ p.WorkspaceID != cardFormWorkspace(form) } hidden?={ p.WorkspaceID != cardFormWorkspace(form) }>{ taskNewProjectLabel(p) }</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="description" class="form-label">Description</label>
                    <textarea id="description" name="description" class="form-input" rows="6" data-paste-attach>{ form.Get("description") }</textarea>
                    <div class="form-hint">Paste images or text files from the clipboard (Ctrl+V).</div>
                    <ul class="paste-attach-list" data-paste-attach-list></ul>
                </div>
            </form>
        </div>
        <div class="action-bar">
            <div class="action-bar-inner">
                <button type="submit" form="task-new-form" class="btn btn-primary action-bar-primary-form" disabled?={ len(projects) == 0 }>Create</button>
                <span class="action-bar-spacer"></span>
            </div>
        </div>
        <script>
            (function () {
                var workspace = document.getElementById("workspace");
                var project = document.getElementById("project_id");
                function update(reset) {
                    var preferred = null;
                    Array.from(project.options).forEach(function (option) {
                        var matches = option.dataset.workspace === workspace.value;
                        option.disabled = !matches;
                        option.hidden = !matches;
                        if (matches && (!preferred || option.dataset.default === "true")) preferred = option;
                    });
                    var current = project.selectedOptions[0];
                    if (preferred && (reset || !current || current.disabled)) project.value = preferred.value;
                }
                workspace.addEventListener("change", function () { update(true); });
                update(false);
            })();
        </script>
    }
}
